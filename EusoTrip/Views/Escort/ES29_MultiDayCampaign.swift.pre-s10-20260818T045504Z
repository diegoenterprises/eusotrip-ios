    private var strip: some View {
        GeometryReader { geo in
            let scale = totalMiles > 0 ? geo.size.width / totalMiles : 0
            HStack(spacing: 0) {
                ForEach(panels) { p in
                    panelView(p).frame(width: max(1, p.miles * scale))
