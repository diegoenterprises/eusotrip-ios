// MARK: - Panel model (the concertina's own arithmetic)

private enum ES29WidthSource { case greatCircle, evenSplit }
private enum ES29RunState { case run, running, ahead }

private struct ES29Panel: Identifiable {
    let id: String
    let index: Int
    let miles: Double
    let widthSource: ES29WidthSource
    let runState: ES29RunState
    let coverage: Double
    let gate: ES29WindGate?
    let origin: String
    let destination: String
}

/// Great-circle miles between two real coordinates. Arithmetic on DB columns —
/// never a substitute for one, and labelled DERIVED wherever it reaches glass.
private func es29GreatCircle(_ a: ES29Point, _ b: ES29Point) -> Double {
    let r = 3958.7568
    let dLat = (b.lat - a.lat) * .pi / 180
    let dLng = (b.lng - a.lng) * .pi / 180
    let la1 = a.lat * .pi / 180, la2 = b.lat * .pi / 180
    let h = sin(dLat / 2) * sin(dLat / 2) + cos(la1) * cos(la2) * sin(dLng / 2) * sin(dLng / 2)
    return 2 * r * asin(min(1, sqrt(h)))
}

/// THE AXIS, and the one piece of arithmetic this screen stands on.
///
/// Chains `corridor.polyline` into per-leg great-circle spans and normalises
/// them to `routedMiles`. Three honest branches:
///   1. polyline aligns to the leg chain and a leg's span is > 0 → measured.
///   2. a leg's two points COINCIDE (a duplicated waypoint — how a staging or
///      parking stop looks in loads.route today) → its great-circle span is
///      0 mi, which cannot be its road distance. That leg falls back to the
///      server's own even split and is flagged `.evenSplit` so the view draws
///      it as the estimate it is.
///   3. the polyline cannot be aligned at all (points were dropped by validPt,
///      escorts.ts:4061) → EVERY panel falls back and the whole strip says so.
private func es29Panels(_ c: ES29CorridorDTO) -> [ES29Panel] {
    let legs = c.legs ?? []
    guard !legs.isEmpty else { return [] }
    let pts = c.corridor?.polyline ?? []
    let total = c.routedMiles
    let even = total.map { $0 / Double(legs.count) } ?? legs.first?.miles ?? 0

    var raw: [Double?] = Array(repeating: nil, count: legs.count)
    if pts.count == legs.count + 1 {
        for i in 0..<legs.count {
            let d = es29GreatCircle(pts[i], pts[i + 1])
            raw[i] = d > 0.0001 ? d : nil
        }
    }
    let measuredSum = raw.compactMap { $0 }.reduce(0, +)
    let fallbackMi = even * Double(raw.filter { $0 == nil }.count)
    let budget = max(0, (total ?? measuredSum + fallbackMi) - fallbackMi)
    let k = measuredSum > 0 ? budget / measuredSum : 0

    return legs.enumerated().map { (i, leg) in
        ES29Panel(
            id: leg.id,
            index: i + 1,
            miles: raw[i].map { $0 * k } ?? even,
            widthSource: raw[i] == nil ? .evenSplit : .greatCircle,
            runState: leg.status == "completed" ? .run
                    : leg.status == "active" ? .running : .ahead,
            coverage: leg.coverage ?? 0,
            gate: leg.wind,
            origin: leg.origin ?? "—",
            destination: leg.destination ?? "—")
    }
}

