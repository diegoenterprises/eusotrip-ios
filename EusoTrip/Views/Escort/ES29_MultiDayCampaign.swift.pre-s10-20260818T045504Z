struct EscortMultiDayCampaignES29: View {

    @Environment(\.palette) private var palette
    @Environment(\.colorScheme) private var scheme
    @EnvironmentObject private var session: EusoTripSession

    private enum Phase { case loading, live, cached, empty, failed }

    @State private var phase: Phase = .loading
    @State private var snap = ES29Snapshot()
    @State private var cacheAge: TimeInterval? = nil
    /// True when the strip on glass came off disk. The gates are not cached,
    /// so on a cached paint every bar drops to the dashed NO DATA register.
    @State private var gatesSuppressed = false

    private let cacheKey = "escort.es29.campaign"
    private let cacheTTL: TimeInterval = 120          // READ_CACHED(120s)

    private var isDark: Bool { scheme == .dark }
    private var greenInk: Color  { isDark ? Color(hex: 0x34D399) : Color(hex: 0x0B7A4B) }
    private var amberInk: Color  { isDark ? Color(hex: 0xFBBF24) : Color(hex: 0xB45309) }
    private var dangerInk: Color { isDark ? Color(hex: 0xF87171) : Color(hex: 0xB91C1C) }
    private var blueInk: Color   { isDark ? Color(hex: 0x60A5FA) : Color(hex: 0x1D4ED8) }

    private var panels: [ES29Panel] { snap.corridor.map(es29Panels) ?? [] }
    private var totalMiles: Double { panels.reduce(0) { $0 + $1.miles } }

    /// Lifecycle-derived, because `coverageForStatus` (escorts.ts:232) is. The
    /// subline and the strip's NOW label both say so; no fix is implied.
    private var coveredMiles: Double {
        panels.reduce(0) { acc, p in
            switch p.runState {
            case .run:     return acc + p.miles
            case .running: return acc + p.miles * p.coverage
            case .ahead:   return acc
            }
        }
    }

    var body: some View {
        VStack(alignment: .leading, spacing: Space.s4) {
            eyebrowRow
            headlineRow
            sublineRow
            IridescentHairline()
            metaRow
            content
            honestyLine
        }
        .padding(.horizontal, Space.s5)
        .padding(.top, Space.s2)
        .task { await refresh() }
        .eusoRefreshable { await refresh() }
    }

    // MARK: Header

    private var eyebrowRow: some View {
        HStack {
            EusoTripEyebrow(verbatim: "ESCORT · CAMPAIGN")
                .font(EType.micro).tracking(1.0)
                .foregroundStyle(LinearGradient.primary)
            Spacer(minLength: Space.s2)
            Text(snap.corridor?.id.map { "ESC-\($0)" } ?? "—")
                .font(EType.mono(.micro)).tracking(0.6)
                .foregroundStyle(palette.textTertiary)
                .lineLimit(1)
        }
    }

    private var headlineRow: some View {
        Text(totalMiles > 0
             ? "\(fmt1(coveredMiles)) of \(fmt1(totalMiles)) mi"
             : "No corridor on this move")
            .font(.system(size: 34, weight: .bold)).tracking(-0.6)
            .monospacedDigit()
            .foregroundStyle(palette.textPrimary)
            .lineLimit(1).minimumScaleFactor(0.6)
    }

    private var sublineRow: some View {
        Text(sublineText)
            .font(EType.caption)
            .foregroundStyle(palette.textSecondary)
            .lineLimit(1).minimumScaleFactor(0.7)
    }

    private var sublineText: String {
        guard let c = snap.corridor else { return "nothing decoded" }
        let lane = [c.origin, c.destination].compactMap { $0 }.joined(separator: " → ")
        let running = panels.firstIndex { $0.runState == .running }.map { $0 + 1 }
        let leg = running.map { "leg \($0) of \(panels.count)" } ?? "\(panels.count) legs"
        return [lane.isEmpty ? nil : lane, leg, "lifecycle-derived"]
            .compactMap { $0 }.joined(separator: " · ")
    }

    /// The meta row lives BELOW the hairline on purpose. Pushing it between the
    /// H1 and the hairline is what dragged the escort band's rules to y162/176/186.
    private var metaRow: some View {
        HStack(spacing: Space.s2) {
            positionBadge(snap.position ?? "lead")
            Text(snap.corridor?.loadNumber ?? "—")
                .font(EType.mono(.caption))
                .foregroundStyle(palette.textSecondary)
                .lineLimit(1)
            Spacer(minLength: Space.s1)
            Text(cacheAge.map { EscortOfflineCache.stalenessLine(age: $0).uppercased() }
                 ?? (session.user?.name ?? "escort"))
                .font(EType.mono(.micro))
                .foregroundStyle(cacheAge == nil ? palette.textTertiary : amberInk)
                .lineLimit(1)
        }
    }

    private func positionBadge(_ raw: String) -> some View {
        Text(raw.uppercased())
            .font(.system(size: 10, weight: .heavy)).tracking(0.5)
