    private func gateInk(_ p: ES29Panel) -> Color {
        switch liveGate(p)?.status {
        case "go":      return greenInk
        case "caution": return amberInk
        case "nogo":    return dangerInk
        default:        return palette.textTertiary
        }
    }
    @ViewBuilder private func gateBar(_ p: ES29Panel) -> some View {
        if let s = liveGate(p)?.status {
            RoundedRectangle(cornerRadius: 3)
