    @ViewBuilder private func panelView(_ p: ES29Panel) -> some View {
        // Mountain / valley alternation is the concertina tell: odd panels
        // stand 6 pt taller, so the top edge of the strip zig-zags.
        let inset: CGFloat = p.index % 2 == 1 ? 0 : 6
        VStack(spacing: 0) {
            ZStack {
                RoundedRectangle(cornerRadius: 3).fill(panelFill(p))
                if p.widthSource == .evenSplit {
                    ES29HatchShape().stroke(palette.textTertiary.opacity(0.45), lineWidth: 1)
                        .clipShape(RoundedRectangle(cornerRadius: 3))
                }
                if p.runState == .running {
                    RoundedRectangle(cornerRadius: 3)
                        .strokeBorder(Brand.blue.opacity(0.55), lineWidth: 1.2)
                }
                VStack(spacing: 2) {
                    Text("L\(p.index)")
                        .font(.system(size: 8, weight: .heavy)).tracking(0.4)
                        .foregroundStyle(palette.textSecondary)
                    Spacer(minLength: 0)
                    Text(gustLabel(p))
                        .font(.system(size: 12, weight: .semibold)).monospacedDigit()
                        .foregroundStyle(gateInk(p))
                    Text(runWord(p))
                        .font(.system(size: 6, weight: .heavy)).tracking(0.5)
                        .foregroundStyle(palette.textTertiary)
                }
                .padding(.vertical, 6)
            }
            .padding(.top, inset)
            gateBar(p).frame(height: 6).padding(.top, 4)
            Text(p.widthSource == .evenSplit ? "EVEN \(fmt1(p.miles))" : fmt1(p.miles))
                .font(.system(size: p.widthSource == .evenSplit ? 6.5 : 7.5,
                              weight: .semibold, design: .monospaced))
                .monospacedDigit()
                .foregroundStyle(p.widthSource == .evenSplit
                                 ? palette.textTertiary : palette.textSecondary)
                .lineLimit(1).minimumScaleFactor(0.6)
                .padding(.top, 3)
                .overlay(alignment: .bottom) {
                    if p.widthSource == .evenSplit {
                        Rectangle()
                            .strokeBorder(style: StrokeStyle(lineWidth: 1, dash: [3, 2]))
                            .foregroundStyle(palette.textTertiary)
                            .frame(height: 1).offset(y: 3)
                    }
                }
        }
        .padding(.horizontal, 0.5)
    }

