    // MARK: Load
    //
    // No `try?`-swallowed decode. A throw is caught explicitly, the cache is
    // consulted once, and if neither answers the screen enters `.failed` and
    // draws its own absence. A swallowed decode is how two escort screens
    // shipped permanently empty.

    private func refresh() async {
        if snap.corridor == nil { await MainActor.run { phase = .loading } }
        do {
            let trip: ES29ActiveTripLite? = try await EusoTripAPI.shared
                .queryNoInput("escorts.getActiveTrip")
            guard let trip, let aid = trip.assignmentId else {
                await MainActor.run { phase = .empty }
                return
            }
            // escorts.ts:3907 wants a STRING id. Deliberate stringify.
            let corridor: ES29CorridorDTO? = try await EusoTripAPI.shared
                .query("escorts.getCorridor", input: ES29IdInput(id: String(aid)))
            guard let corridor else {
                // A null here is the ownership gate or a routeless load —
                // an answer, not an error.
                await MainActor.run { phase = .empty }
                return
            }
            var next = ES29Snapshot()
            next.corridor = corridor
            next.startedAt = trip.startedAt
            next.position = trip.position
            EscortOfflineCache.store(next, key: cacheKey)
            await MainActor.run {
                snap = next
                cacheAge = nil
                gatesSuppressed = false
                phase = (corridor.legs?.isEmpty ?? true) ? .empty : .live
            }
        } catch {
            // One fall back to disk, then honest failure. The gates are
            // suppressed on any cached paint — see OFFLINE.
            if let hit = EscortOfflineCache.load(ES29Snapshot.self, key: cacheKey, ttl: cacheTTL) {
                await MainActor.run {
                    snap = hit.value
                    cacheAge = hit.age
                    gatesSuppressed = true
                    phase = .cached
                }
            } else {
                await MainActor.run { phase = .failed }
            }
        }
    }
}

// MARK: - Hatch (the unmeasured-panel treatment)

private struct ES29HatchShape: Shape {
    var step: CGFloat = 6
    func path(in rect: CGRect) -> Path {
        var p = Path()
        var x = rect.minX - rect.height
        while x < rect.maxX {
            p.move(to: CGPoint(x: x, y: rect.maxY))
            p.addLine(to: CGPoint(x: x + rect.height, y: rect.minY))
            x += step
        }
        return p
    }
}

