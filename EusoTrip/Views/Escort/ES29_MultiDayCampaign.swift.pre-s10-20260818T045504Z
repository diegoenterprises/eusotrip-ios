    /// A suppressed (cached) or `available:false` gate is NEVER a zero and
    /// NEVER a green — it is an em dash over a dashed outline.
    private func liveGate(_ p: ES29Panel) -> ES29WindGate? {
        guard !gatesSuppressed, let g = p.gate, g.available == true else { return nil }
        return g
    }
    private func gustLabel(_ p: ES29Panel) -> String {
        guard let g = liveGate(p), let mph = g.gust else { return "—" }
        return String(Int(mph.rounded()))
