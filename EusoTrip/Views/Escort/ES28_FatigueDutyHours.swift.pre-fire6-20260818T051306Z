/// The ragged left edge of the uncaptured lead-in.
struct ES28TornHead: Shape {
    func path(in r: CGRect) -> Path {
        var p = Path()
        let teeth = 3
        let step = r.height / CGFloat(teeth * 2)
        p.move(to: CGPoint(x: r.maxX, y: r.minY))
        p.addLine(to: CGPoint(x: r.minX + 8, y: r.minY))
        for i in 0..<(teeth * 2) {
            let y = r.minY + step * CGFloat(i + 1)
            p.addLine(to: CGPoint(x: i % 2 == 0 ? r.minX : r.minX + 8, y: y))
        }
        p.addLine(to: CGPoint(x: r.maxX, y: r.maxY))
        p.closeSubpath()
        return p
    }
}

