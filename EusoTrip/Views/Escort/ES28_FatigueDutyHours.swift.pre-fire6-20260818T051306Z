enum ES28UnreadableReason: String, Equatable {
    /// startedAt nil AND completedAt nil — the row was never on the clock.
    case neverStarted
    /// PROBE (e), THE SECOND HOLE. completedAt SET, startedAt NULL.
    /// escorts.updateJobStatus takes `status: z.string()` (escorts.ts:1172) —
    /// an unvalidated free string with no enum and no transition guard — so a
    /// client can post status:"completed" on a row that never reached
    /// 'escorting'. escorts.ts:1202 stamps completedAt unconditionally while
    /// escorts.ts:1201 only stamps startedAt on the 'escorting' transition.
    /// Coalescing this to a zero-length interval would SILENTLY DELETE real
    /// duty time from the total. It is surfaced instead.
    case completedWithoutStart
    /// PROBE (a). completedAt < startedAt — clock skew or a manual edit. A
    /// negative interval would SUBTRACT and make a fatigued escort read rested.
    case negativeInterval
    case nonFiniteInterval
    /// PROBE (h), THE START STAMP MOVED. startedAt is NOT set-once on the
    /// server: hazmatEscort.ts:180 and convoy.ts:292 both rewrite it with no
    /// !startedAt guard, and the unvalidated `status: z.string()` at
    /// escorts.ts:1172 (and again at escorts.ts:641) makes the status rollback
    /// that reaches them a two-call, no-privilege operation. A rewritten stamp
    /// makes a 12-hour shift read 0:00 — the UNSAFE direction. When the
    /// session watch sees the value jump FORWARD for the same assignment, the
    /// figure is refused rather than repainted as a fresh clock.
    case startStampMovedForward
}

enum ES28IntervalReading: Equatable {
    case closed(TimeInterval)
    /// PROBE (b). startedAt set, completedAt nil. Counted as OPEN and disclosed
    /// separately — never coalesced to 0.
    case open(TimeInterval)
    case unreadable(ES28UnreadableReason)
    /// PROBE (d). Quarantined, not folded, not dropped.
    case implausible(TimeInterval)
}

struct ES28DutyInterval: Equatable {
    let assignmentId: Int
    let startedAt: Date?
    let completedAt: Date?
}

enum ES28DutyFold {

    static func read(_ i: ES28DutyInterval, now: Date) -> ES28IntervalReading {
        guard let start = i.startedAt else {
            return .unreadable(i.completedAt == nil ? .neverStarted : .completedWithoutStart)
        }
        let end = i.completedAt ?? now
        let raw = end.timeIntervalSince(start)
        guard raw.isFinite else { return .unreadable(.nonFiniteInterval) }
        if raw < 0 { return .unreadable(.negativeInterval) }
        if raw > ES28DutyRules.implausibleSingleIntervalHours * 3600 { return .implausible(raw) }
        return i.completedAt == nil ? .open(raw) : .closed(raw)
    }

    /// PROBE (c). Nothing in escorts.updateJobStatus prevents two rows sitting
    /// in 'escorting' at once, so a naive SUM double-counts. A body cannot be on
    /// duty twice, so the UNION is the correct duty semantics — but the union is
    /// SHORTER than the naive sum, i.e. it moves in the permissive direction.
    /// It is therefore used AND disclosed: the merge count rides on the surface
    /// so a silent permissive merge is impossible.
    static func union(_ spans: [(start: Date, end: Date)]) -> (seconds: TimeInterval, overlaps: Int) {
        guard !spans.isEmpty else { return (0, 0) }
        let sorted = spans.sorted { $0.start < $1.start }
        var total: TimeInterval = 0
        var overlaps = 0
        var cur = sorted[0]
        for s in sorted.dropFirst() {
            if s.start <= cur.end {
                overlaps += 1
                if s.end > cur.end { cur.end = s.end }
            } else {
                total += cur.end.timeIntervalSince(cur.start)
                cur = s
            }
        }
        total += cur.end.timeIntervalSince(cur.start)
        return (max(0, total), overlaps)
    }

    /// PROBE (h). Pure half of the start-stamp defence: has this read's
    /// startedAt moved FORWARD relative to the earliest value previously
    /// observed for the same assignment? A forward jump can only mean the
    /// column was rewritten, because no legitimate path moves a set startedAt
    /// later — escorts.ts:1201 and escorts.ts:2861 are both set-once.
    /// The tolerance absorbs clock jitter and fractional-second re-encoding;
    /// it is deliberately small, since the attack moves the stamp by hours.
    static func startStampMovedForward(previousEarliest: Date?,
                                       current: Date,
                                       tolerance: TimeInterval = 60) -> Bool {
        guard let previous = previousEarliest else { return false }
        return current.timeIntervalSince(previous) > tolerance
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - ES28StartStampWatch — the client-side half of disclosure (d)
//
// WHAT IT CATCHES. Within one app session it remembers the EARLIEST startedAt
// seen per assignmentId. If a later read comes back with the stamp moved
// forward, the shift figure is refused and the gauge prints
// START STAMP MOVED · UNREADABLE instead of a fresh, restful-looking clock.
//
// WHAT IT CANNOT CATCH, STATED PLAINLY RATHER THAN IMPLIED. A rewrite that
// lands BEFORE the first read of a session is INVISIBLE to any client. There
// is no prior value to compare against: no procedure in the tree returns a
// history of escortAssignments.startedAt, and updateJobStatus writes no audit
// row behind the stamp (it is not among the recordAuditEvent call sites in
// escorts.ts). This watch is a mitigation, not a guard. The guard has to land
// on the server, and its exact shape is filed as ESC-DUTY-ENUM in the header.
// ─────────────────────────────────────────────────────────────────────────────

@MainActor
final class ES28StartStampWatch {
    static let shared = ES28StartStampWatch()

    private var earliestSeen: [Int: Date] = [:]

    /// Records this read and reports whether the stamp jumped forward.
    /// Idempotent for repeated observations of the same value, so the trip
    /// gauge and the open-row fold may both call it for the same assignment.
    func observe(assignmentId: Int, startedAt: Date) -> Bool {
        guard let previous = earliestSeen[assignmentId] else {
            earliestSeen[assignmentId] = startedAt
            return false
        }
        if ES28DutyFold.startStampMovedForward(previousEarliest: previous, current: startedAt) {
            return true
        }
        // Keep the earliest value: a backwards correction is not the attack,
        // and holding the floor keeps the comparison honest on later reads.
        if startedAt < previous { earliestSeen[assignmentId] = startedAt }
        return false
    }

    /// Test seam only. Never called from the surface.
    func reset() { earliestSeen.removeAll() }
}

/// What the column actually renders. Note there is deliberately NO
/// `remainingHours` unless the whole window is readable — see `headroom`.
struct ES28DutyWindow: Equatable {
    let windowStart: Date
    let windowEnd: Date
    let readSeconds: TimeInterval
    let openSeconds: TimeInterval
    let unreadableCount: Int
    let implausibleCount: Int
    let overlapCount: Int
    let readableDayCount: Int
    /// False until `escorts.getDutyWindows` exists. Guard on PRESENCE, not on
    /// truthiness: a 0-hour week and an unreadable week are not the same fact.
    let foldAvailable: Bool

    var totalDayCount: Int { ES28DutyRules.windowDays }
    var readHours: Double { readSeconds / 3600 }

    /// Geometry only. Clamped so no input can paint past the ceiling.
    var drawFraction: Double {
        ES28DutyRules.clampForDrawing(readHours, ceiling: ES28DutyRules.weekCeilingHours)
            / ES28DutyRules.weekCeilingHours
    }

    /// The verdict runs on the UNCLAMPED value so an over-limit can never be
    /// hidden by the clamp that protects the drawing.
    var isOverCeiling: Bool { readHours > ES28DutyRules.weekCeilingHours }

    /// The single most dangerous number this screen could print. It is `nil`
    /// unless every day in the window is readable and nothing was quarantined.
    var headroomHours: Double? {
        guard foldAvailable,
              unreadableCount == 0,
              implausibleCount == 0,
              readableDayCount == totalDayCount else { return nil }
        return max(0, ES28DutyRules.weekCeilingHours - readHours)
    }
}

enum ES28Format {
    /// H:MM. A nil or negative input renders as an em-dash, never as 0:00 —
    /// "no reading" and "zero hours" are different facts on a fatigue surface.
    static func hhmm(_ seconds: TimeInterval?) -> String {
        guard let s = seconds, s.isFinite, s >= 0 else { return "\u{2014}" }
        let m = Int(s / 60)
        return String(format: "%d:%02d", m / 60, m % 60)
    }
}

/// The smaller, separate gauge. Different clock, different confidence.
struct ES28ShiftGauge: Equatable {
    /// nil when the open row has startedAt NULL — drawn as an em-dash, not 0.
    let elapsed: TimeInterval?
    let startedAtLocal: String?
    /// PROBE (h). True when ES28StartStampWatch saw this assignment's startedAt
    /// move FORWARD inside the session. `elapsed` is forced nil alongside it,
    /// so the numeral falls to an em-dash rather than to a fresh, small figure.
    let startStampMoved: Bool

    init(elapsed: TimeInterval?, startedAtLocal: String?, startStampMoved: Bool = false) {
        self.elapsed = elapsed
        self.startedAtLocal = startedAtLocal
        self.startStampMoved = startStampMoved
    }

    var hours: Double? { elapsed.map { $0 / 3600 } }

    /// min() clamp on the drawing.
    var drawFraction: Double {
        guard let h = hours else { return 0 }
        return ES28DutyRules.clampForDrawing(h, ceiling: ES28DutyRules.shiftCeilingHours)
            / ES28DutyRules.shiftCeilingHours
    }

    /// Verdict on the unclamped value.
    var isOverLimit: Bool { (hours ?? 0) > ES28DutyRules.shiftCeilingHours }

    var display: String { ES28Format.hhmm(elapsed) }
}

