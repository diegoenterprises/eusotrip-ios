enum ES28DutyLoadError: Error, LocalizedError, Equatable {
    case transport(String)
    case decode(String)
    var errorDescription: String? {
        switch self {
        case .transport(let m): return "Could not reach the duty record — \(m)"
        case .decode(let m):    return "Duty record did not decode — \(m)"
        }
    }
}

