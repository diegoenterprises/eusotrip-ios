struct ES28View: View {
    @Environment(\.palette) private var palette
    @StateObject private var vm: ES28ViewModel

    init(service: any ES28DutyService) {
        _vm = StateObject(wrappedValue: ES28ViewModel(service: service))
    }

    var body: some View {
        VStack(alignment: .leading, spacing: 0) {
            header
            // The ONE IridescentHairline on this screen (COMPONENTS.md:91).
            Rectangle().fill(palette.iridescentHairline).frame(height: 1)
            switch vm.state {
            case .loading:
                loadingBand
            case .failed(let message):
                // Never an empty column on a failure. An empty column reads
                // as "rested", which is the one thing this screen must not say.
                failureBand(message)
            case .unproven:
                // PROBE (i). Distinct from BOTH the failure band and a reading.
                unprovenBand
            case .loaded:
                content
            }
        }
        .task { await vm.load() }
    }

    // MARK: header — DETAIL archetype, H1 28, no meta row above the hairline

    private var header: some View {
        VStack(alignment: .leading, spacing: 0) {
            HStack {
                Text("\u{2726} ESCORT \u{00B7} DUTY & FATIGUE")
                    .font(.system(size: 9, weight: .heavy)).tracking(1.0)
                    .foregroundStyle(LinearGradient(colors: [Brand.blue, Brand.magenta],
                                                    startPoint: .leading, endPoint: .trailing))
                Spacer()
                Text("ESC-260817-44021")
                    .font(.system(size: 9, weight: .heavy, design: .monospaced)).tracking(1.0)
                    .foregroundStyle(palette.textTertiary)
            }
            .padding(.horizontal, 20).padding(.top, 12)

            HStack(spacing: 8) {
                Image(systemName: "chevron.left")
                    .font(.system(size: 18, weight: .semibold))
                    .foregroundStyle(palette.textPrimary)
                Text("Duty & fatigue")
                    .font(.system(size: 28, weight: .bold)).tracking(-0.4)
                    .foregroundStyle(palette.textPrimary)
            }
            .padding(.horizontal, 20).padding(.top, 14).padding(.bottom, 12)
        }
    }

    private var loadingBand: some View {
        Text("READING THE DUTY RECORD\u{2026}")
            .font(.system(size: 9, weight: .heavy)).tracking(1.0)
            .foregroundStyle(palette.textTertiary)
            .padding(20)
    }

    private func failureBand(_ message: String) -> some View {
        VStack(alignment: .leading, spacing: 6) {
            Text("DUTY RECORD UNAVAILABLE")
                .font(.system(size: 11, weight: .heavy)).tracking(0.6)
                .foregroundStyle(Brand.danger)
            Text(message)
                .font(.system(size: 11)).foregroundStyle(palette.textSecondary)
            Text("NO FIGURE IS SHOWN. AN EMPTY COLUMN WOULD READ AS RESTED.")
                .font(.system(size: 8, weight: .heavy, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .padding(16)
        .background(RoundedRectangle(cornerRadius: 16).fill(palette.bgCard))
        .overlay(RoundedRectangle(cornerRadius: 16).stroke(Brand.danger.opacity(0.45)))
        .padding(.horizontal, 20).padding(.top, 16)
    }

    /// PROBE (i). The server answered 200 with nothing. That is not an error
    /// and it is not a reading, so it gets neither of their treatments: a
    /// hatched, dashed band in warning ink, with the three swallows pinned.
    private var unprovenBand: some View {
        VStack(alignment: .leading, spacing: 6) {
            HStack(spacing: 8) {
                Image(systemName: "questionmark.circle")
                    .font(.system(size: 14, weight: .bold))
                Text("DUTY RECORD NOT PROVEN \u{00B7} NOT ZERO")
                    .font(.system(size: 11, weight: .heavy)).tracking(0.6)
            }
            .foregroundStyle(Brand.warning)
            Text("Duty history is unavailable. No hours are shown until assignment and settlement records can be confirmed.")
                .font(.system(size: 11)).foregroundStyle(palette.textSecondary)
            Text("Refresh when connected. If the record remains unavailable, contact dispatch.")
                .font(.system(size: 7.5, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
            Text("MISSING HISTORY IS NOT COUNTED AS REST")
                .font(.system(size: 8, weight: .heavy)).tracking(0.2)
                .foregroundStyle(Brand.danger)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .padding(16)
        .background(RoundedRectangle(cornerRadius: 16).fill(palette.tintWarning))
        .overlay(RoundedRectangle(cornerRadius: 16)
            .stroke(style: StrokeStyle(lineWidth: 1.5, dash: [5, 3]))
            .foregroundStyle(Brand.warning.opacity(0.8)))
        .padding(.horizontal, 20).padding(.top, 16)
    }

    private var content: some View {
        VStack(alignment: .leading, spacing: 20) {
            sectionHeader("ROLLING DUTY WINDOW \u{00B7} 7 DAYS",
                          right: "ASSIGNMENT + SETTLEMENT RECORDS")
            if let w = vm.window { accumulator(w) }        // the one ActiveCard

            sectionHeader("THIS SHIFT", right: "ESCORTING TIME \u{00B7} PREP + TRAVEL EXCLUDED")
            if let g = vm.gauge { shiftGauge(g) }

            sectionHeader("OPEN ROWS ON THE CLOCK", right: "REVIEW START TIMES")
            openRows

            designedVoid
        }
        .padding(.top, 16)
    }

    private func sectionHeader(_ left: String, right: String) -> some View {
        HStack {
            Text(left).font(.system(size: 9, weight: .heavy)).tracking(1.0)
            Spacer()
            Text(right).font(.system(size: 9, weight: .heavy)).tracking(0.4)
        }
        .foregroundStyle(palette.textTertiary)
        .padding(.horizontal, 20)
    }

    // MARK: the accumulator column — the ONE rimmed ActiveCard

    private func accumulator(_ w: ES28DutyWindow) -> some View {
        VStack(alignment: .leading, spacing: 8) {
            Text("60 H CEILING \u{00B7} HOUSE RULE, NOT STATUTE")
                .font(.system(size: 10, weight: .heavy)).tracking(0.6)
                .foregroundStyle(Brand.danger)
                .monospacedDigit()
            Text("COMPANY SAFETY LIMIT \u{00B7} CONFIRM THE DUTY RULES FOR EACH ASSIGNMENT")
                .font(.system(size: 7.5, weight: .bold)).tracking(0.3)
                .foregroundStyle(palette.textTertiary)
            Rectangle().fill(Brand.danger).frame(height: 3)

            HStack(alignment: .top, spacing: 16) {
                column(w)
                readout(w)
            }

            // ── THE COST OF THE FOLD, on the card face and not in a comment ──
            Text("\(w.readableDayCount) OF \(w.totalDayCount) DAYS CONFIRMED \u{00B7} \(w.ledgerRows) ASSIGNMENT RECORDS \u{00B7} \(w.loadsProbed) OF \(w.loadsSeen) LOADS CHECKED")
                .font(.system(size: 7, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
            Text("FIGURES USE CONFIRMED SETTLEMENT AND ASSIGNMENT RECORDS")
                .font(.system(size: 7, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
            Text("MISSING RECORDS REMAIN UNKNOWN AND ARE NOT COUNTED AS REST")
                .font(.system(size: 7, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
        }
        .padding(16)
        .frame(maxWidth: .infinity, alignment: .leading)
        .background(RoundedRectangle(cornerRadius: 18.5).fill(palette.bgCard))
        .padding(1.5)
        .background(
            RoundedRectangle(cornerRadius: 20)
                .fill(LinearGradient(colors: [Brand.blue.opacity(0.85), Brand.magenta.opacity(0.85)],
                                     startPoint: .topLeading, endPoint: .bottomTrailing))
        )
        .padding(.horizontal, 20)
    }

    /// 200 pt of column against the 60 H ceiling, oldest day at the BOTTOM.
    /// Every stratum whose seconds are known is drawn TO SCALE. A day that is
    /// known to be zero is drawn as a floor marker, not as nothing — a measured
    /// zero and an unmeasurable day are different facts. A day that could not be
    /// measured (truncated ledger page or exhausted probe budget) keeps the old
    /// hatched treatment at a NOMINAL height, and the nominal height is biased
    /// toward MORE hours, because on a fatigue instrument the only safe way to
    /// draw an unknown is toward fatigue.
    private func column(_ w: ES28DutyWindow) -> some View {
        let unit = 200.0 / ES28DutyRules.weekCeilingHours
        func height(_ d: ES28DayStratum) -> CGFloat {
            guard let h = d.hours else { return 21 }        // nominal, hatched
            if h <= 0 { return 3 }                          // measured zero
            return max(11, CGFloat(min(h, ES28DutyRules.weekCeilingHours) * unit))
        }
        return HStack(alignment: .top, spacing: 6) {
            VStack(alignment: .trailing, spacing: 0) {
                Spacer(minLength: 0)
                ForEach(w.days) { d in
                    Text(d.label)
                        .foregroundStyle(d.id == w.days.last?.id ? Brand.warning : palette.textTertiary)
                        .frame(height: height(d), alignment: .center)
                }
            }
            .font(.system(size: 8, weight: .bold, design: .monospaced))
            .frame(height: 200)

            VStack(spacing: 0) {
                // the unclaimed span above the stack is NOT headroom
                VStack(spacing: 2) {
                    Text("THIS GAP IS").foregroundStyle(palette.textTertiary)
                    Text("NOT HEADROOM").foregroundStyle(Brand.warning)
                }
                .font(.system(size: 8, weight: .heavy)).tracking(0.4)
                .frame(maxWidth: .infinity, maxHeight: .infinity)

                ForEach(w.days) { d in
                    stratum(d).frame(height: height(d))
                }
            }
            .frame(width: 100, height: 200)
            .overlay(Rectangle().stroke(palette.borderSoft))
        }
    }

    @ViewBuilder
    private func stratum(_ d: ES28DayStratum) -> some View {
        if let s = d.seconds {
            ZStack(alignment: .trailing) {
                if d.isOpen {
                    // Still running: the full brand gradient plus a dashed top
                    // edge, because this stratum is not finished growing.
                    Rectangle().fill(LinearGradient(colors: [Brand.blue, Brand.magenta],
                                                    startPoint: .topLeading,
                                                    endPoint: .bottomTrailing))
                        .overlay(alignment: .top) {
                            Rectangle()
                                .stroke(style: StrokeStyle(lineWidth: 1, dash: [3, 2]))
                                .foregroundStyle(.white.opacity(0.8))
                                .frame(height: 1)
                        }
                } else {
                    Rectangle().fill(Brand.blue.opacity(0.55))
                }
                Text(ES28Format.hhmm(s) + (d.isOpen ? " \u{00B7} OPEN" : ""))
                    .font(.system(size: 8, weight: .heavy)).tracking(0.3)
                    .monospacedDigit()
                    .foregroundStyle(.white)
                    .padding(.trailing, 6)
                    .opacity(s > 0 ? 1 : 0)
            }
        } else {
            ZStack(alignment: .trailing) {
                Rectangle().fill(palette.tintNeutral)
                Text("\u{2014}")
                    .font(.system(size: 9, weight: .bold))
                    .foregroundStyle(palette.textTertiary)
                    .padding(.trailing, 22)
            }
            .overlay(Rectangle().stroke(style: StrokeStyle(lineWidth: 1, dash: [3, 2]))
                .foregroundStyle(palette.textTertiary.opacity(0.55)))
        }
    }

    private func readout(_ w: ES28DutyWindow) -> some View {
        VStack(alignment: .leading, spacing: 6) {
            Text("READ IN WINDOW")
                .font(.system(size: 9, weight: .heavy)).tracking(1.0)
                .foregroundStyle(palette.textTertiary)
            HStack(alignment: .lastTextBaseline, spacing: 6) {
                Text(w.provenance == .corroborated ? ES28Format.hhmm(w.readSeconds) : "\u{2014}")
                    .font(.system(size: 28, weight: .semibold)).monospacedDigit()
                    .foregroundStyle(palette.textPrimary)
                Text("H:MM").font(.system(size: 9, weight: .heavy)).tracking(0.6)
                    .foregroundStyle(palette.textTertiary)
            }
            // The headroom figure is printed ONLY when it is real, which — while
            // escorts.ts:1201 stamps only 'escorting' — is never.
            Group {
                if let h = w.headroomHours {
