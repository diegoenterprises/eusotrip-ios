                Text("DISPLAY CAPPED AT 14 H \u{00B7} RECORDED START TIME UNCHANGED")
                    .font(.system(size: 7.5, weight: .bold, design: .monospaced))
                    .foregroundStyle(palette.textTertiary)
            }
            Text("STAGING \u{00B7} PRE-TRIP \u{00B7} DEADHEAD ARE NOT IN THIS CLOCK.")
                .font(.system(size: 8, weight: .heavy)).tracking(0.2)
                .foregroundStyle(Brand.warning)
            Text("CLOCK STARTS WHEN ESCORTING BEGINS \u{00B7} PRE-TRIP AND DEADHEAD TIME EXCLUDED")
                .font(.system(size: 7.5, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)

            // ── DISCLOSURE (d) · the start stamp itself is overwritable ──
            // The torn head discloses the span the clock never captured. This
            // discloses that the clock's zero can be moved beneath the escort.
            // Both live on the gauge, not in a footnote, for the same reason.
            Rectangle().fill(Brand.danger.opacity(0.30)).frame(height: 1)
            Text("START TIME CAN CHANGE \u{00B7} REVIEW THE ASSIGNMENT RECORD IF THIS LOOKS WRONG")
                .font(.system(size: 8, weight: .heavy)).tracking(0.2)
                .foregroundStyle(Brand.danger)
            Text("A CHANGED START TIME CAN REDUCE THE DISPLAYED DURATION")
                .font(.system(size: 6.5, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
            Text("EARLIER ACTIVITY MAY NOT APPEAR AFTER A START-TIME CHANGE")
                .font(.system(size: 6.5, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
            // ── DISCLOSURE (e) · an empty payload is refused, not drawn as 0 ──
            Text("MISSING ACTIVITY IS NOT SHOWN AS 0:00")
                .font(.system(size: 6.5, weight: .bold, design: .monospaced))
                .foregroundStyle(palette.textTertiary)
        }
        .padding(16)
        .frame(maxWidth: .infinity, alignment: .leading)
        .background(RoundedRectangle(cornerRadius: 16).fill(palette.bgCard))
        .overlay(RoundedRectangle(cornerRadius: 16).stroke(palette.borderFaint))
        .overlay(alignment: .leading) {
            RoundedRectangle(cornerRadius: 1.5).fill(Brand.warning).frame(width: 3)
        }
        .padding(.horizontal, 20)
    }

