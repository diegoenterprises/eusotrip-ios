/// THE DEFAULT THE REGISTRY GETS. All four procedures were opened at the line
/// this fire and all four are bound live.
///
/// Nothing is softened: no call is wrapped in `try?` and none falls back to an
/// empty payload. A failure propagates to ES28ViewModel.load(), which paints
/// the failure band, because an empty column on a fatigue instrument reads as
/// RESTED. The two procedures that fail OPEN on the server side
/// (escorts.ts:2171, escorts.ts:2846) are caught by ES28EmptyPayloadGuard
/// instead, which cannot un-swallow them but can refuse to draw them.
struct ES28LiveService: ES28DutyService {
    /// escorts.getActiveTrip — escorts.ts:2787. Returns null when the escort
    /// has no open assignment, which decodes straight into the nil case.
    func activeTrip() async throws -> ES28ActiveTripDTO? {
        try await EusoTripAPI.shared.queryNoInput("escorts.getActiveTrip")
    }
    /// escorts.getMyTeam — escorts.ts:2026.
    func openAssignments() async throws -> [ES28OpenAssignmentDTO] {
        try await EusoTripAPI.shared.queryNoInput("escorts.getMyTeam")
    }
    /// escorts.listSettlements — escorts.ts:4723. The `status` filter
    /// (escorts.ts:4725) is deliberately OMITTED so completed assignments are
    /// included; `limit` is the input at escorts.ts:4726.
    func settlementLedger(limit: Int) async throws -> [ES28SettlementRowDTO] {
        struct In: Encodable { let limit: Int }
        return try await EusoTripAPI.shared.query("escorts.listSettlements",
                                                  input: In(limit: limit))
    }
    /// loads.getEscortAssignment — loads.ts:2029. NOTE the input is declared
    /// `z.string()` at loads.ts:2030 and parsed with parseInt at loads.ts:2034,
    /// so the id goes over the wire as a STRING or the call 400s.
    func escortRows(loadId: Int) async throws -> [ES28LoadEscortRowDTO] {
        struct In: Encodable { let loadId: String }
        return try await EusoTripAPI.shared.query("loads.getEscortAssignment",
                                                  input: In(loadId: String(loadId)))
    }
}

/// INJECTABLE TEST DOUBLE ONLY — not the registry default.
/// Every method throws, so a caller can exercise the fail-closed path
/// deliberately and confirm that the surface paints the failure band rather
/// than an empty column.
struct ES28UnboundService: ES28DutyService {
    func activeTrip() async throws -> ES28ActiveTripDTO? {
        throw ES28DutyLoadError.transport(
            "escorts.getActiveTrip (escorts.ts:2787) is not bound in this service")
    }
    func openAssignments() async throws -> [ES28OpenAssignmentDTO] {
        throw ES28DutyLoadError.transport(
            "escorts.getMyTeam (escorts.ts:2026) is not bound in this service")
    }
    func settlementLedger(limit: Int) async throws -> [ES28SettlementRowDTO] {
        throw ES28DutyLoadError.transport(
            "escorts.listSettlements (escorts.ts:4723) is not bound in this service")
    }
    func escortRows(loadId: Int) async throws -> [ES28LoadEscortRowDTO] {
        throw ES28DutyLoadError.transport(
            "loads.getEscortAssignment (loads.ts:2029) is not bound in this service")
    }
}

enum ES28ViewState: Equatable {
    case loading
    case failed(String)
    /// PROBE (i). Every read answered 200 with nothing. Visibly distinct from
    /// `.failed` (which names a thrown error) AND from a real reading, and it
    /// paints no numeral at all.
    case unproven
    case loaded
}

@MainActor
final class ES28ViewModel: ObservableObject {
    @Published private(set) var state: ES28ViewState = .loading
    @Published private(set) var window: ES28DutyWindow?
    @Published private(set) var gauge: ES28ShiftGauge?
    @Published private(set) var rows: [ES28OpenAssignmentDTO] = []

    private let service: any ES28DutyService
    private let clock: () -> Date
    private let calendar: Calendar

    init(service: any ES28DutyService,
         clock: @escaping () -> Date = Date.init,
         calendar: Calendar = .current) {
        self.service = service
        self.clock = clock
        self.calendar = calendar
    }

    /// No load failure is swallowed anywhere on this path — no `try?`, no
    /// `?? []`, no empty-array fallback. A swallowed decode is how two escort
    /// screens shipped permanently empty; on THIS surface it would hand a
    /// fatigued escort an empty column, which reads as RESTED. A thrown failure
    /// paints the failure band and no figure at all; a 200-with-nothing paints
    /// the unproven band and no figure at all.
    func load() async {
        state = .loading
        do {
            async let tripTask   = service.activeTrip()
            async let rowsTask   = service.openAssignments()
            async let ledgerTask = service.settlementLedger(limit: ES28DutyRules.settlementsPageLimit)
            let (trip, open, ledger) = try await (tripTask, rowsTask, ledgerTask)

            let now = clock()
            rows = open

            // ── PROBE (i) · the transport layer, before any arithmetic ──
            let provenance = ES28EmptyPayloadGuard.provenance(trip: trip,
                                                             openRows: open,
                                                             ledger: ledger)
            guard provenance == .corroborated else {
                gauge = ES28ShiftGauge(elapsed: nil, startedAtLocal: nil,
                                       startStampMoved: false, provenance: provenance)
                window = Self.emptyWindow(now: now, calendar: calendar, provenance: provenance)
                state = .unproven
                return
            }

            // ── the shift gauge — from the one open 'escorting' row ──
            if let t = trip, let iso = t.startedAt, let d = Self.parseISO(iso) {
                // PROBE (h). The stamp is not set-once on the server
                // (hazmatEscort.ts:180, convoy.ts:292 — see the writer table).
                // A forward jump inside the session means it was rewritten, and
                // a rewritten stamp reads as a fresh clock on a tired escort.
                let moved = ES28StartStampWatch.shared.observe(assignmentId: t.assignmentId,
                                                               startedAt: d)
                let raw = now.timeIntervalSince(d)
                let usable = !moved && raw.isFinite && raw >= 0
                gauge = ES28ShiftGauge(elapsed: usable ? raw : nil,
                                       startedAtLocal: usable ? Self.localTime(d) : nil,
                                       startStampMoved: moved,
                                       provenance: provenance)
            } else {
                // Guard on PRESENCE, not truthiness. No startedAt is not 0:00.
                gauge = ES28ShiftGauge(elapsed: nil, startedAtLocal: nil,
                                       startStampMoved: false, provenance: provenance)
            }

            // ── THE SEVEN-DAY FOLD, call 2 · loads.getEscortAssignment ──
            // The ledger (call 1) is already self-scoped by the server at
            // escorts.ts:4732, so its assignment ids are the ONLY ids this
            // screen will accept back out of the unscoped call 2.
            let ownedIds = Set(ledger.map(\.assignmentId))
            // Descending loadId is the only recency proxy available: the ledger
            // carries no completedAt and no date filter (escorts.ts:4723-4743),
            // so when the probe budget bites it must bite the OLDEST loads.
            let loadIds  = Array(Set(ledger.map(\.loadId))).sorted(by: >)
            let loadsSeen = loadIds.count
            let probeList = Array(loadIds.prefix(ES28DutyRules.loadProbeBudget))

            let svc = service
            var fetched: [ES28LoadEscortRowDTO] = []
            try await withThrowingTaskGroup(of: [ES28LoadEscortRowDTO].self) { group in
                var issued = 0
                var inFlight = 0
                while issued < probeList.count || inFlight > 0 {
                    while inFlight < ES28DutyRules.loadProbeConcurrency, issued < probeList.count {
                        let id = probeList[issued]
                        issued += 1
                        inFlight += 1
                        group.addTask { try await svc.escortRows(loadId: id) }
                    }
                    if let batch = try await group.next() {
                        inFlight -= 1
                        fetched.append(contentsOf: batch)
                    }
                }
            }

            // Drop every counter-party row unread — ESC-DUTY-LEAK is the loads
            // lane's to close; this screen simply refuses to consume it.
            let mine = ES28DutyFold.selfRows(fetched, ownedAssignmentIds: ownedIds)

            // The OPEN rows are still folded in: a row on the clock right now
            // has no completedAt anywhere, so call 2 alone would under-report
            // today by the whole running interval.
            var intervals: [ES28DutyInterval] = mine.map {
                ES28DutyInterval(assignmentId: $0.id,
                                 startedAt: $0.startedAt.flatMap(Self.parseISO),
                                 completedAt: $0.completedAt.flatMap(Self.parseISO))
            }
            let seenIds = Set(mine.map(\.id))
            for r in open where !seenIds.contains(r.assignmentId) {
                intervals.append(ES28DutyInterval(assignmentId: r.assignmentId,
                                                  startedAt: r.startedAt.flatMap(Self.parseISO),
                                                  completedAt: nil))
            }

            var spans: [(start: Date, end: Date)] = []
            var openSeconds: TimeInterval = 0
            var unreadable = 0, implausible = 0
            var openSpanDays = Set<Date>()
            for i in intervals {
                // PROBE (h) again, per row: a rewritten stamp shortens the fold
                // exactly as it shortens the gauge, so it is quarantined into
                // the UNREADABLE count rather than folded as a short interval.
                if let st = i.startedAt,
                   ES28StartStampWatch.shared.observe(assignmentId: i.assignmentId, startedAt: st) {
                    unreadable += 1
                    continue
                }
                switch ES28DutyFold.read(i, now: now) {
                case .closed(let s):
                    if let st = i.startedAt { spans.append((st, st.addingTimeInterval(s))) }
                case .open(let s):
                    openSeconds += s
                    if let st = i.startedAt {
                        spans.append((st, st.addingTimeInterval(s)))
                        openSpanDays.insert(calendar.startOfDay(for: st.addingTimeInterval(s)))
                    }
                case .unreadable:  unreadable += 1
                case .implausible: implausible += 1
                }
            }

            // Trim the union to the window so an assignment that started before
            // the window cannot pour its whole length into day 7.
            let today = calendar.startOfDay(for: now)
            let dayStarts: [Date] = (0..<ES28DutyRules.windowDays).compactMap {
                calendar.date(byAdding: .day, value: -$0, to: today)
            }
            let windowStart = dayStarts.last ?? today
            let clipped: [(start: Date, end: Date)] = spans.compactMap {
                let lo = max($0.start, windowStart)
                let hi = min($0.end, now)
                return hi > lo ? (lo, hi) : nil
            }
            let merged = ES28DutyFold.union(clipped)
            let buckets = ES28DutyFold.bucketByDay(spans: clipped,
                                                   days: dayStarts,
                                                   calendar: calendar)

            // A day is MEASURED when the ledger page and the probe budget both
            // covered it. If either was truncated the OLDEST days are the ones
            // that may be missing, so they — and only they — fall to nil rather
            // than to a comfortable-looking small number.
            let complete = ledger.count < ES28DutyRules.settlementsPageLimit
                && probeList.count == loadsSeen
            let days: [ES28DayStratum] = dayStarts.map { d in
                ES28DayStratum(dayStart: d,
                               label: Self.dayLabel(d),
                               seconds: complete ? (buckets[d] ?? 0) : buckets[d].flatMap { $0 > 0 ? $0 : nil },
                               isOpen: openSpanDays.contains(d))
            }

            window = ES28DutyWindow(
                windowStart: windowStart,
                windowEnd: now,
                readSeconds: merged.seconds,
                openSeconds: openSeconds,
                unreadableCount: unreadable,
                implausibleCount: implausible,
                overlapCount: merged.overlaps,
                days: days,
                provenance: provenance,
                ledgerRows: ledger.count,
                loadsProbed: probeList.count,
                loadsSeen: loadsSeen,
                foldComplete: complete
            )
            state = .loaded
        } catch let error as ES28DutyLoadError {
            switch error {
            case .transport:
                state = .failed("Duty history couldn't be reached. Check your connection and try again.")
            case .decode:
                state = .failed("Duty history couldn't be read. Pull to retry.")
            }
        } catch {
            state = .failed("Duty history couldn't be loaded. Pull to retry.")
        }
    }

    /// The shape drawn when nothing can be stood behind: seven unmeasured
    /// strata and a zero total that the surface never prints.
    private static func emptyWindow(now: Date,
                                    calendar: Calendar,
                                    provenance: ES28Provenance) -> ES28DutyWindow {
        let today = calendar.startOfDay(for: now)
        let dayStarts: [Date] = (0..<ES28DutyRules.windowDays).compactMap {
            calendar.date(byAdding: .day, value: -$0, to: today)
        }
        return ES28DutyWindow(
            windowStart: dayStarts.last ?? today,
            windowEnd: now,
            readSeconds: 0, openSeconds: 0,
            unreadableCount: 0, implausibleCount: 0, overlapCount: 0,
            days: dayStarts.map { ES28DayStratum(dayStart: $0, label: dayLabel($0),
                                                 seconds: nil, isOpen: false) },
            provenance: provenance,
            ledgerRows: 0, loadsProbed: 0, loadsSeen: 0, foldComplete: false)
    }

    private static let iso: ISO8601DateFormatter = {
        let f = ISO8601DateFormatter()
        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
        return f
    }()
    private static let isoPlain: ISO8601DateFormatter = {
        let f = ISO8601DateFormatter(); f.formatOptions = [.withInternetDateTime]; return f
    }()
    static func parseISO(_ s: String) -> Date? { iso.date(from: s) ?? isoPlain.date(from: s) }
    static func localTime(_ d: Date) -> String {
        let f = DateFormatter(); f.dateFormat = "HH:mm"; return f.string(from: d)
    }
    static func dayLabel(_ d: Date) -> String {
        let f = DateFormatter(); f.dateFormat = "MMM d"
        return f.string(from: d).uppercased()
    }
}

