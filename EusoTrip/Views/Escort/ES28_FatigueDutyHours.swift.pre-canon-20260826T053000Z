import SwiftUI

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Duty rules (all thresholds are compile-time constants)
//
// Nothing on this surface reads a threshold out of a payload. The 60 H ceiling
// and the 14 H shift limit are `let` constants here so that no server response,
// no cache and no decoded field can widen either one.
// ─────────────────────────────────────────────────────────────────────────────

enum ES28DutyRules {
    /// House shift limit. NOT a statute: escorts are HOS-exempt (ROLES.ESCORT is
    /// absent from `hosReadProcedure`, hos.ts:28-39).
    static let shiftCeilingHours: Double = 14
    /// House rolling-week ceiling. Also not a statute, for the same reason.
    static let weekCeilingHours: Double = 60
    static let windowDays: Int = 7
    /// Any single interval longer than this is quarantined rather than folded.
    /// A garbage `startedAt` (epoch) yields ~490 000 h; folding it pins the
    /// column at the ceiling — the SAFE direction — but destroys the strata,
    /// so it is counted and surfaced instead of being silently absorbed.
    static let implausibleSingleIntervalHours: Double = 24

    /// escorts.listSettlements caps its page at 100 — `z.number().min(1)
    /// .max(100).default(25)` at escorts.ts:4726. Asking for the maximum is
    /// the only way to widen the window, and even the maximum does not PROVE
    /// completeness: see `ES28DutyWindow.foldComplete`.
    static let settlementsPageLimit: Int = 100

    /// Ceiling on the N+1 fan-out of loads.getEscortAssignment (loads.ts:2029).
    /// A phone on a corridor must not fire 100 serialised round trips to paint
    /// one card. Exhausting this budget does NOT silently shorten the week —
    /// it drops `foldComplete` to false and the surface says so.
    static let loadProbeBudget: Int = 60

    /// Maximum concurrent call-2 probes. Bounded so the fold cannot saturate
    /// a weak link and time the whole screen out.
    static let loadProbeConcurrency: Int = 6

    /// TRUE while escorts.ts:1201 stamps `startedAt` only on the 'escorting'
    /// transition. While it is true, EVERY figure derived by subtracting this
    /// column from the 60 H ceiling errs in the PERMISSIVE direction — it says
    /// the escort has MORE left than they do. It is the reason `headroomHours`
    /// is nil even now that the seven-day fold is readable. Flip it only when
    /// the server stamps an on-duty time rather than an escorting time.
    static let shiftClockUnderReports: Bool = true

    /// The min() clamp. Applied to GEOMETRY only.
    static func clampForDrawing(_ hours: Double, ceiling: Double) -> Double {
        min(max(0, hours), ceiling)
    }
}

// ─────────────────────────────────────────────────────────────────────────────
// MARK: - Wire models
//
// Typed against what the producer actually emits, field by field.
//   escorts.getActiveTrip     escorts.ts:2787 → startedAt is emitted as an
//     ISO-8601 STRING or null at escorts.ts:2824 (`?.toISOString() || null`).
//   escorts.getMyTeam         escorts.ts:2026 → startedAt likewise at :2166.
//   escorts.listSettlements   escorts.ts:4723 → rows returned RAW at :4743.
//   loads.getEscortAssignment loads.ts:2029   → both stamps at :2070-2071.
//   `rate` on the escort surfaces is already parseFloat'd server-side
//     (escorts.ts:2821, :2151) so it arrives as a JSON number — but the raw
//     drizzle `decimal` columns behind it serialize as STRINGS, which is the
//     class that has killed three escort screens. `netPayout` on
//     listSettlements is exactly such a column and is DELIBERATELY NOT DECODED
//     here: this screen has no business reading money, and an undeclared key is
//     an ignored key. Any numeric field that does come straight off a
//     decimal/BIGINT aggregate is decoded through `ES28LenientSeconds`, which
//     accepts both shapes rather than being typed Double and blowing up.
// ─────────────────────────────────────────────────────────────────────────────

/// Accepts an integer, a double, or a numeric string. MySQL returns SUM() over
/// a decimal/bigint as a STRING through drizzle; typing it `Int` throws.
struct ES28LenientSeconds: Codable, Equatable {
    let value: Int
    init(from decoder: Decoder) throws {
        let c = try decoder.singleValueContainer()
        // The two `try?`s below are a TYPE PROBE, not a swallowed error: the
        // ladder ends in a throwing `decode(String.self)` plus an explicit
        // dataCorruptedError, so an unexpected shape still surfaces. Nothing on
        // this file swallows a load failure.
        if let i = try? c.decode(Int.self) { value = i; return }
        if let d = try? c.decode(Double.self) { value = Int(d.rounded()); return }
        let s = try c.decode(String.self)
        guard let d = Double(s) else {
            throw DecodingError.dataCorruptedError(in: c, debugDescription: "seconds not numeric: \(s)")
        }
        value = Int(d.rounded())
    }
    func encode(to encoder: Encoder) throws {
        var c = encoder.singleValueContainer(); try c.encode(value)
    }
    init(_ v: Int) { value = v }
}

