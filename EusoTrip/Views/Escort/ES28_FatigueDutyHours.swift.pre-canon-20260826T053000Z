enum ES28DutyLoadError: Error, LocalizedError, Equatable {
    case transport(String)
    case decode(String)
    var errorDescription: String? {
        switch self {
        case .transport(let m): return "Could not reach the duty record — \(m)"
        case .decode(let m):    return "Duty record did not decode — \(m)"
        }
    }
}

/// `Sendable` because the call-2 fan-out below runs the probes in a bounded
/// task group off the main actor. Every conformer is a struct of value types.
protocol ES28DutyService: Sendable {
    /// escorts.getActiveTrip — escorts.ts:2787
    func activeTrip() async throws -> ES28ActiveTripDTO?
    /// escorts.getMyTeam — escorts.ts:2026
    func openAssignments() async throws -> [ES28OpenAssignmentDTO]
    /// escorts.listSettlements — escorts.ts:4723. CALL 1 of the fold.
    func settlementLedger(limit: Int) async throws -> [ES28SettlementRowDTO]
    /// loads.getEscortAssignment — loads.ts:2029. CALL 2 of the fold.
    func escortRows(loadId: Int) async throws -> [ES28LoadEscortRowDTO]
