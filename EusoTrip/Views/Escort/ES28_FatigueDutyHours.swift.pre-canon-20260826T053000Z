                ES28TornHead().fill(Brand.warning.opacity(0.35)).frame(width: 28, height: 12)
                ZStack(alignment: .leading) {
                    Capsule().fill(palette.bgCardSoft).frame(height: 12)
                    GeometryReader { geo in
                        Capsule()
