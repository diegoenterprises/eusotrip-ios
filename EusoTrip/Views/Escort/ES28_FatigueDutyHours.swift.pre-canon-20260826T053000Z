                Text("14 H HOUSE LIMIT")
                    .font(.system(size: 9, weight: .heavy)).tracking(0.6).monospacedDigit()
                    .foregroundStyle(g.isOverLimit ? Brand.danger : palette.textTertiary)
            }
            // PROBE (h). The stamp moved forward inside this session, so the
            // figure is refused. It is NOT repainted as a small, restful number.
            if g.startStampMoved {
                Text("START STAMP MOVED \u{00B7} UNREADABLE \u{2014} NOT A FRESH CLOCK")
                    .font(.system(size: 9, weight: .heavy)).tracking(0.4)
                    .foregroundStyle(Brand.danger)
            }
            HStack(spacing: 10) {
                Text(g.display)
                    .font(.system(size: 26, weight: .semibold)).monospacedDigit()
                    .foregroundStyle(palette.textPrimary)
                // TORN HEAD: the uncaptured lead-in has no known length, so its
