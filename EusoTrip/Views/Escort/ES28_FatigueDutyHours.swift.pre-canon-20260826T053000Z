            }
            HStack {
                Text("NOT CAPTURED")
                    .font(.system(size: 7.5, weight: .heavy)).tracking(0.3)
                    .foregroundStyle(Brand.warning)
                Spacer()
                // Scoped honestly: the clamp protects the arithmetic, not the
