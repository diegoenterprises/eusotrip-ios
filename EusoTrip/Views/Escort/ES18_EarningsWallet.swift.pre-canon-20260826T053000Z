    // MARK: Derived figures

    /// `nil` means the figure could not be read on this pass — NOT that it is zero.
    /// `?? 0` here was the whole defect: it turned a swallowed read into a headline.
    private var periodGross: Double? {
        if let t = history?.totalEarnings, t > 0 { return t }
        guard let stats else { return nil }
        switch period {
        case .week:  return stats.thisWeek
        case .month: return stats.thisMonth
        default:     return stats.thisYear
        }
    }

    /// THE FOURTH STATE. `getEarningsStats` and `getEarningsHistory` both answer a DB
    /// exception with an all-zero literal at HTTP 200 (escorts.ts:2665/:2684 and :1976,
    /// plus :1967 no-db and :1970 no-user). That payload carries exactly the keys and
    /// types the success path carries, so — unlike `wallet.getBalance`, which leaks
    /// `stripeBalance` only on its read path — NO CLIENT-SIDE DISCRIMINATOR EXISTS.
    /// A stats-derived zero is therefore genuinely three-valued and the screen says so
    /// rather than silently electing the flattering reading.
    ///
    /// Note the deliberate asymmetry with the settlement-fed cells: `listSettlements`
    /// THROWS on a missing db handle (escorts.ts:4730) instead of swallowing, so a zero
    /// from that feed IS a real zero and needs no such hedge. The hedge is applied
    /// exactly where the server made the fact unrecoverable, and nowhere else.
    static let ambiguousZeroLine =
        "ZERO CANNOT BE VERIFIED FROM THIS SUMMARY · REVIEW SETTLEMENTS BEFORE RELYING ON IT"

    /// True when a figure folded off `stats`/`history` landed and is exactly zero.
    /// `statsLive` is required: an unread figure is already handled as `nil` upstream and
    /// must not also collect the ambiguity line, or two distinct states would look alike.
    ///
    /// Lifted to a static over plain values for the same reason `foldSlices` was: the
    /// defect class this row keeps failing on lives inside a `View`, where exercising it
    /// needs a server in exactly the wrong state. As a free function the DEBUG harness at
    /// the bottom of this file can drive it to all four cases directly.
    fileprivate static func isAmbiguousZero(statsLive: Bool, _ v: Double?) -> Bool {
        guard statsLive, let v else { return false }
        return v == 0
    }

    private func isAmbiguousZero(_ v: Double?) -> Bool {
        Self.isAmbiguousZero(statsLive: statsLive, v)
    }

    private var periodGrossIsAmbiguousZero: Bool { isAmbiguousZero(periodGross) }

    /// `nil` when there is no live balance, or when the response in hand was one of
    /// `wallet.getBalance`'s two never-read-the-ledger branches. Either way there is no
    /// spendable figure to show, which is not the same fact as $0.00. A genuine zero
    /// that came off the wallets row DOES return 0 here and DOES print as $0.00 — the
    /// point of the discriminator is to keep those two apart, not to suppress zeros.
    private var availableBalance: Double? {
        guard let b = balance, b.readFromLedger else { return nil }
        return b.available
    }
    // Note both conditions are required: the ledger must have been read AND the figure
    // must have arrived. Either one missing is "unknown", and neither is "$0.00".

    private var periodMoves: Int { history?.jobCount ?? settlements.count }

    /// `nil` when the distance read did not land. Miles are not money, but a fabricated
    /// quantity is the same lie in different units, and this figure has EXACTLY the
    /// three-valued-zero problem the money cells have: `loads.distance` is coalesced to
    /// 0 per row at escorts.ts:2448 before it reaches the wire, the whole array is
    /// swallowed to `[]` at :2427 / :2430 / :2451, and a genuinely zero-mile period is
    /// indistinguishable from both.
    private var periodMiles: Int? {
        guard !completedFailed else { return nil }
        return Int(completed.compactMap(\.distance).reduce(0, +).rounded())
    }

    private var pendingRows: [ES18Settlement] {
        settlements.filter { ($0.settlementStatus ?? "pending") != "paid" }
    }
    /// `nil` when there are pending rows but not one of them carried an amount — which,
    /// under the PAID ⟺ AMOUNT invariant, is what a real period looks like. The coalesce
    /// is written out at this call site, beside the guard that makes it safe.
    private var pendingTotal: Double? {
        guard !pendingRows.isEmpty else { return 0 }
        guard pendingUnreadCount < pendingRows.count else { return nil }
        return pendingRows.compactMap(\.payoutValue).reduce(0, +)
    }
    /// How many pending rows carried no readable amount — surfaced beside the total so
    /// a fold over incomplete rows is never presented as a complete one.
    private var pendingUnreadCount: Int { pendingRows.filter(\.isUnread).count }
    /// The disclosure beside PENDING. Three sentences for three facts: a complete fold,
    /// a partial one, and nothing to fold at all.
    private var pendingLine: String {
        let n = pendingRows.count
        let plural = n == 1 ? "" : "S"
        if n == 0 { return "0 SETTLEMENTS" }
        if pendingUnreadCount == 0 { return "\(n) SETTLEMENT\(plural)" }
        if pendingUnreadCount == n { return "\(n) SETTLEMENT\(plural) · NO AMOUNT UNTIL PAID" }
        return "\(n) SETTLEMENT\(plural) · \(pendingUnreadCount) NO AMOUNT READ"
    }
    private var lastPaidRow: ES18Settlement? {
        settlements.first { $0.settlementStatus == "paid" }
    }

    /// The client-side fold. Only positions the server actually returned appear —
    /// a seat the column cannot express is never fabricated into a slice.
    ///
    /// The fold carries a FOURTH accumulator, `unread`, alongside the money. Without it
    /// the count of NULLs was discarded at the moment of summing and the render site had
    /// no way to recover it, so a bucket of nothing and a bucket of zeros arrived at the
    /// cell as the same `Double`. That discard was the defect; this counter is the fix.
    private var slices: [ES18Slice] {
        let milesByAssignment: [String: Double] = Dictionary(
            completed.map { ($0.id, $0.distance ?? 0) }, uniquingKeysWith: { a, _ in a })
        return Self.foldSlices(settlements: settlements, milesByAssignment: milesByAssignment)
    }

    /// Lifted out of the computed property on purpose. The defect this row kept failing
    /// on lived inside a `View`, where the only way to exercise it was to run the app
    /// against a database in exactly the wrong state. As a static function over plain
    /// values it can be driven straight to the NULL bucket, the all-zero bucket and the
    /// mixed bucket — which is what the DEBUG harness at the bottom of this file does,
    /// so the three states are checked by construction and not by hope.
    fileprivate static func foldSlices(settlements: [ES18Settlement],
                                       milesByAssignment: [String: Double]) -> [ES18Slice] {
        var buckets: [ES18Position: (moves: Int, miles: Double, amount: Double, unread: Int)] = [:]
        for row in settlements {
            guard let pos = ES18Position.from(row.position) else { continue }
            var b = buckets[pos] ?? (0, 0, 0, 0)
            b.moves += 1
            b.miles += milesByAssignment[String(row.assignmentId)] ?? 0
            // The coalesce is written here, at the call site, where the diff shows it
            // sitting next to the counter that makes it safe. `payoutValue` is nil for
            // every row that is not `paid` — see the PAID ⟺ AMOUNT invariant.
            if let v = row.payoutValue { b.amount += v } else { b.unread += 1 }
            buckets[pos] = b
        }
        // The denominator is built ONLY from buckets that are complete. A share computed
        // against a total that silently omits unread money would put every bar at the
        // wrong length and every percentage above its truth.
        let completeTotal = buckets.values
            .filter { $0.unread == 0 }
            .map(\.amount)
            .reduce(0, +)
        return buckets
            .map { entry -> ES18Slice in
                let v = entry.value
                let whollyUnread = v.unread == v.moves && v.moves > 0
                return ES18Slice(
                    position: entry.key,
                    moves: v.moves,
                    miles: Int(v.miles.rounded()),
                    amount: whollyUnread ? nil : v.amount,
                    unread: v.unread,
                    // Complete buckets only, and only when there is a real denominator.
                    share: (v.unread == 0 && completeTotal > 0) ? v.amount / completeTotal : nil)
            }
            // Unread buckets sort last: a row with no amount cannot claim a rank among
            // rows that have one. Within each group, larger money first.
            .sorted { a, b in
                switch (a.amount, b.amount) {
                case let (x?, y?): return x > y
                case (_?, nil):    return true
                case (nil, _?):    return false
                default:           return a.moves > b.moves
                }
            }
    }

    // MARK: Data

    private func load(force: Bool = false) async {
        loading = true
        defer { loading = false }

        // READ_CACHED(10m) for the period aggregates only.
        if !force,
           let cached = EscortOfflineCache.load(ES18Snapshot.self,
                                                key: Self.cacheKey, ttl: Self.cacheTTL) {
            stats = cached.value.stats
            history = cached.value.history
            settlements = cached.value.settlements
            completed = cached.value.completed
            // Cache-restored settlements power the analytics cards under the staleness
            // line, but they are NOT live — the wallet block's PENDING and LAST CREDIT
            // stay blank until a live read lands.
            settlementsLive = false
            settlementsFailed = false
            // Same for the pay record: a restored `stats` is a real figure, but it is
            // not this pass's, so it paints under the staleness line and never LIVE.
            statsLive = false
            statsFailed = false
            stalenessLine = EscortOfflineCache.stalenessLine(age: cached.age)
        }

        async let statsCall: ES18Stats? = try? await EusoTripAPI.shared.query(
            "escorts.getEarningsStats", input: ES18PeriodInput(period: period.rawValue))
        async let historyCall: ES18History? = try? await EusoTripAPI.shared.query(
            "escorts.getEarningsHistory", input: ES18PeriodInput(period: period.rawValue))
        async let settleCall: [ES18Settlement]? = try? await EusoTripAPI.shared.query(
            "escorts.listSettlements", input: ES18SettlementsInput(limit: 25))
        async let completedCall: [ES18CompletedJob]? = try? await EusoTripAPI.shared.query(
            "escorts.getCompletedJobs", input: ES18CompletedInput(limit: 25, period: period.rawValue))
        // The wallet read is live-or-nothing. It is never written to the snapshot.
        // `wallet.getBalance`, NOT `payments.getBalance` — the latter sums a table an
        // escort settlement never touches (see the LEDGER note in the file header).
        async let balanceCall: ES18WalletBalance? = try? await EusoTripAPI.shared.query(
            "wallet.getBalance", input: ES18EmptyInput())

        let (s, h, st, cj, bal) = await (statsCall, historyCall, settleCall, completedCall, balanceCall)

        balance = bal
        balanceUnavailable = (bal == nil)

        // The settlements read is resolved BEFORE the stats guard, because the wallet
        // block's honesty does not depend on whether the stats call came back.
        // `st == []` is the server saying zero. `st == nil` is the read failing. They
        // are different facts and the screen must not merge them: merging them is how
        // a swallowed error paints "$0.00 · 0 SETTLEMENTS" beside a green LIVE dot.
        if let st {
            settlements = st
            settlementsLive = true
            settlementsFailed = false
        } else {
            // Do NOT collapse to []. Keep whatever the snapshot restored, blank the two
            // settlement-derived money figures, and say the read failed.
            settlementsLive = false
            settlementsFailed = true
            // The freshness slot may not claim LIVE while a money read is missing.
            stalenessLine = "settlement read failed · figures held back"
        }

        // The stats read gets the same treatment the settlements read just got: the
        // failure is RECORDED, not swallowed. Returning here with the flags untouched
        // is what let a green LIVE dot sit over a $0.00 that nobody ever read.
        guard let s else {
            statsLive = false
            statsFailed = true
            // The freshness slot may not read LIVE while a money read is missing. Which
            // line depends on what survived: a cold open has no figure at all, a cache
            // restore has one but it is not this pass's.
            stalenessLine = settlementsFailed
                ? "pay-record + settlement reads failed · figures held back"
                : (stats == nil
                    ? "pay-record read failed · figures held back"
                    : "pay-record refresh failed · figures are the last cached read")
            if stats == nil {
                errorMessage = "Couldn't reach the pay record. Pull to retry."
            }
            return
        }

        stats = s
        statsLive = true
        statsFailed = false
        history = h
        // Do NOT collapse to []. `nil` is "the distance read did not land"; `[]` is "the
        // server says you completed nothing this period". Merging them is how the mile
        // figures would report 0 for a read nobody got an answer to.
        if let cj {
            completed = cj
            completedFailed = false
        } else {
            completedFailed = true
        }
        // The freshness slot only clears back to LIVE when every read on this pass
        // landed; the settlement failure keeps its own line on glass. Reaching this
        // line at all means the stats read landed, so LIVE is now true of both.
        if !settlementsFailed { stalenessLine = nil }
        errorMessage = nil

        // Only write the snapshot when the settlements in hand are the ones the server
        // just sent. Re-storing a restored list would stamp stale money with a fresh
        // age and quietly extend its TTL.
        if settlementsLive {
            EscortOfflineCache.store(
                ES18Snapshot(stats: s, history: h, settlements: settlements, completed: completed),
                key: Self.cacheKey)
        }
    }

    // MARK: Primitives

    private func sectionEyebrow(_ title: String) -> some View {
        Text(title).font(.system(size: 9, weight: .heavy)).tracking(1.0)
            .foregroundStyle(palette.textTertiary)
    }

    /// Money folded off `stats`. A missing figure — because the read failed, or because
    /// the server omitted the key — renders the em dash, never a formatted zero. The
    /// two facts are not interchangeable and this screen will not merge them.
    private func statsMoney(_ v: Double?) -> String {
        guard stats != nil, let v else { return "—" }
        return currency(v)
    }

    /// The fallback is `$%.2f` of the value in hand and NOT the literal "$0.00". A
    /// formatter that fails is not evidence that the money is zero, and this file has
    /// spent four gates on exactly that substitution — it does not get to make it one
    /// last time in a fallback nobody reads.
    private func currency(_ v: Double) -> String {
        let f = NumberFormatter()
        f.numberStyle = .currency
        f.currencyCode = "USD"
        f.minimumFractionDigits = 2
        f.maximumFractionDigits = 2
        return f.string(from: NSNumber(value: v)) ?? String(format: "$%.2f", v)
    }
}

