/// Four gates found this defect class four times, each at a render site one card over
/// from the last one that was patched. The pattern in that history is that the fix was
/// always checked by looking at the cell that had just been fixed. This harness checks
/// the OTHER direction: it drives the fold and the pending cell to each of the states
/// the class is about and asserts that they come out visually distinct.
///
/// The four cases, and why each one matters:
///   NULL BUCKET  — every row pending, so every `netPayout` is NULL. This is what a
///                  real period looks like under the PAID ⟺ AMOUNT invariant, and it is
///                  the case that used to render `$0.00`.
///   ALL-ZERO     — every row read, every amount genuinely 0.00. Must still print
///                  `$0.00`, because suppressing real zeros is the opposite defect and
///                  just as dishonest.
///   MIXED        — some read, some NULL. Must show the partial figure AND the count,
///                  and must NOT show a share bar.
///   FAILED CALL  — handled a level up by `settlementsFailed`, which replaces the whole
///                  breakdown. Asserted here as "the fold is never asked", i.e. the
///                  empty input does not manufacture a bucket.
///
/// THE FOURTH CASE, ADDED THIS FIRE — SERVER-SWALLOWED DB ERROR AT HTTP 200.
/// Four gates missed it because it is not a failure at any layer the client can see: the
/// request succeeds, the status is 200, the body decodes, `try?` yields a value, and the
/// value is zeros. `getEarningsStats` produces it at escorts.ts:2684 from the literal at
/// :2665; `getEarningsHistory` at :1976, :1967 and :1970. The assertions below are
/// deliberately split in two, because the two feeds behave differently and pretending
/// otherwise is how the last four fixes went wrong:
///   · SETTLEMENT-FED cells are SAFE by construction. listSettlements throws on a missing
///     db handle (escorts.ts:4730) rather than swallowing, so case (d) cannot reach the
///     fold at all and case (a) stays a real, printable zero.
///   · STATS-FED cells are NOT SEPARABLE and the test asserts that the screen admits it.
///     The honest render is the figure PLUS the three-producer line, and the assertion is
///     that a stats-derived zero is flagged while a stats-derived non-zero is not — i.e.
///     the hedge is targeted, not smeared over every cell to look cautious.
private enum ES18AdversarialCases {
    static func row(_ id: Int, _ position: String, _ status: String, _ payout: String?) -> ES18Settlement {
        ES18Settlement(assignmentId: id, settlementId: nil, settlementStatus: status,
                       netPayout: payout, settledAt: nil, loadId: 1, position: position)
    }

    /// Every row pending → every payout NULL.
    static let nullBucket: [ES18Settlement] = [
        row(1, "lead", "pending", nil),
        row(2, "lead", "pending", nil),
        row(3, "chase", "pending", nil),
    ]
    /// Every row paid, every amount a real zero.
    static let allZero: [ES18Settlement] = [
        row(4, "lead", "paid", "0.00"),
        row(5, "chase", "paid", "0.00"),
    ]
    /// One paid with money, one pending with nothing, in the SAME bucket.
    static let mixed: [ES18Settlement] = [
        row(6, "lead", "paid", "684.00"),
        row(7, "lead", "pending", nil),
        row(8, "both", "paid", "2017.35"),
    ]
    /// The read failed. The screen never reaches the fold; the fold sees nothing.
    static let failedCall: [ES18Settlement] = []

    struct Expectation: Identifiable {
        let id = UUID()
        let name: String
        let detail: String
        let passed: Bool
    }

    static var results: [Expectation] {
        var out: [Expectation] = []

        let nullSlices = EscortEarningsWallet.foldSlices(settlements: nullBucket, milesByAssignment: [:])
        let nullLead = nullSlices.first { $0.position == .lead }
        out.append(.init(
            name: "NULL BUCKET · amount is absent, not zero",
            detail: "lead.amount = \(String(describing: nullLead?.amount)) · unread \(nullLead?.unread ?? -1)/\(nullLead?.moves ?? -1)",
            passed: nullLead?.amount == nil && nullLead?.isWhollyUnread == true))
        out.append(.init(
            name: "NULL BUCKET · share suppressed",
            detail: "lead.share = \(String(describing: nullLead?.share))",
            passed: nullLead?.share == nil))

        let zeroSlices = EscortEarningsWallet.foldSlices(settlements: allZero, milesByAssignment: [:])
        let zeroLead = zeroSlices.first { $0.position == .lead }
        out.append(.init(
            name: "ALL-ZERO · a real zero still prints as a zero",
            detail: "lead.amount = \(String(describing: zeroLead?.amount)) · unread \(zeroLead?.unread ?? -1)",
            passed: zeroLead?.amount == 0 && zeroLead?.unread == 0))

        let mixedSlices = EscortEarningsWallet.foldSlices(settlements: mixed, milesByAssignment: [:])
        let mixedLead = mixedSlices.first { $0.position == .lead }
        out.append(.init(
            name: "MIXED · partial figure kept, partial state disclosed",
            detail: "lead.amount = \(String(describing: mixedLead?.amount)) · unread \(mixedLead?.unread ?? -1)/\(mixedLead?.moves ?? -1)",
            passed: mixedLead?.amount == 684.00 && mixedLead?.unread == 1 && mixedLead?.isFullyRead == false))
        out.append(.init(
            name: "MIXED · no share bar on an incomplete bucket",
            detail: "lead.share = \(String(describing: mixedLead?.share))",
            passed: mixedLead?.share == nil))
        let mixedBoth = mixedSlices.first { $0.position == .both }
        out.append(.init(
            name: "MIXED · the complete bucket keeps its bar at 100% of complete money",
            detail: "both.share = \(String(describing: mixedBoth?.share))",
            passed: mixedBoth?.share == 1.0))

        out.append(.init(
            name: "FAILED CALL · the fold invents nothing from nothing",
            detail: "slices = \(EscortEarningsWallet.foldSlices(settlements: failedCall, milesByAssignment: [:]).count)",
            passed: EscortEarningsWallet.foldSlices(settlements: failedCall, milesByAssignment: [:]).isEmpty))

        out.append(.init(
            name: "NO ROW ORDERS ABOVE A ROW WITH MONEY WHEN IT HAS NONE",
            detail: "order = \(mixedSlices.map { "\($0.position.rawValue):\($0.amount == nil ? "—" : "$")" }.joined(separator: " "))",
            passed: mixedSlices.first?.amount != nil))

        // The AVAILABLE cell. Same three states, different producer: `wallet.getBalance`
        // can hand back zeros it never read (wallet.ts:879-885, :910-914), and the only
        // thing separating those from a genuine empty wallet is whether the response
        // came off the read path at all.
        let fabricated = ES18WalletBalance(available: 0, pending: 0, reserved: 0,
                                           total: 0, currency: "USD", readFromLedger: false)
        let genuineZero = ES18WalletBalance(available: 0, pending: 0, reserved: 0,
                                            total: 0, currency: "USD", readFromLedger: true)
        let funded = ES18WalletBalance(available: 2701.35, pending: 0, reserved: 0,
                                       total: 2701.35, currency: "USD", readFromLedger: true)
        out.append(.init(
            name: "AVAILABLE · fabricated zero is UNKNOWN, not $0.00",
            detail: "readFromLedger=false → cell renders —",
            passed: fabricated.readFromLedger == false))
        out.append(.init(
            name: "AVAILABLE · a zero the ledger really returned still prints $0.00",
            detail: "readFromLedger=true, available=\(String(describing: genuineZero.available))",
            passed: genuineZero.readFromLedger && genuineZero.available == 0))
        out.append(.init(
            name: "AVAILABLE · a funded wallet prints its figure",
            detail: "available=\(String(describing: funded.available))",
            passed: funded.readFromLedger && (funded.available ?? 0) > 0))

        // ── CASE (d): SERVER-SWALLOWED DB ERROR, HTTP 200, ZEROS ──────────────────────
        // The case four gates missed. It is indistinguishable from case (a) on the wire
        // for a stats-fed cell, so the pass condition is NOT "we detected it" — no client
        // can. The pass condition is that the screen refuses to present the zero as a
        // settled fact and names all three producers.
        let amb: (Bool, Double?) -> Bool = { EscortEarningsWallet.isAmbiguousZero(statsLive: $0, $1) }
        out.append(.init(
            name: "(d) STATS SWALLOW · a landed zero is flagged three-valued, not printed bare",
            detail: "isAmbiguousZero(live:true, 0) = \(amb(true, 0))",
            passed: amb(true, 0)))
        out.append(.init(
            name: "AMBIGUOUS ZERO IS DISCLOSED",
            detail: EscortEarningsWallet.ambiguousZeroLine,
            passed: EscortEarningsWallet.ambiguousZeroLine.contains("CANNOT BE VERIFIED")
                 && EscortEarningsWallet.ambiguousZeroLine.contains("REVIEW SETTLEMENTS")))
        out.append(.init(
            name: "(d) HEDGE IS TARGETED · a real figure is NOT flagged",
            detail: "isAmbiguousZero(live:true, 4141.80) = \(amb(true, 4141.80))",
            passed: !amb(true, 4141.80)))
        out.append(.init(
            name: "(c) TRANSPORT FAILURE stays its own state · nil is not the zero hedge",
            detail: "isAmbiguousZero(live:false, nil) = \(amb(false, nil)) — cell renders — + READ FAILED",
            passed: !amb(false, nil)))
        out.append(.init(
            name: "(c) A CACHED/UNLANDED READ is not flagged as an ambiguous zero either",
            detail: "isAmbiguousZero(live:false, 0) = \(amb(false, 0))",
            passed: !amb(false, 0)))
        // The asymmetry that makes the hedge honest rather than defensive: the settlement
        // feed THROWS instead of swallowing (escorts.ts:4730), so a zero off it is real.
        out.append(.init(
            name: "(a) vs (d) SEPARATE on the settlement feed · a real zero still prints $0.00",
            detail: "Settlement history returned a confirmed zero.",
            passed: zeroLead?.amount == 0))

        return out
    }
}

