/// `escorts.listSettlements` row (escorts.ts:4723).
private struct ES18Settlement: Codable, Identifiable, Hashable {
    let assignmentId: Int
    let settlementId: String?
    let settlementStatus: String?
    let netPayout: String?
    let settledAt: String?
    let loadId: Int?
    let position: String?
    var id: Int { assignmentId }
    /// `nil` when the row arrived without a parseable payout string. `netPayout` is a
    /// nullable column selected raw (escorts.ts:4734-4742), so an unsettled row ships
    /// NULL routinely — "we did not read an amount" is NOT the same fact as "the amount
    /// is zero", and a money cell must never conflate them.
    ///
    /// There is deliberately NO `payout: Double` convenience accessor on this type.
    /// One existed and it was the defect: three separate gates found a fresh render
    /// site coalescing through it — `$0.00` printed for an amount nobody read, on a
    /// cell with no state of its own. Removing the accessor makes the class
    /// unrepresentable rather than merely unwritten: a render site must call
    /// `payoutValue` and handle nil, and a sum must coerce at its own call site where
    /// the choice is visible in the diff. Do not reintroduce it.
    var payoutValue: Double? { Double(netPayout ?? "") }

    /// There is ALSO deliberately no `payoutForSum: Double` here. One existed. Its doc
    /// comment said "only legitimate inside a fold" and the fold's output was rendered
    /// as a per-position money cell, so the coalesce reached a single-row render anyway
    /// — that was the fourth gate. Both remaining folds now write `payoutValue ?? 0` at
    /// their own call sites, where the coalesce is visible in the diff, AND both carry
    /// the count of lines they could not read so the sum can refuse to render as a
    /// number when every line in it was unknown. Do not reintroduce the accessor: the
    /// only safe coalesce is one you can see beside the disclosure it requires.
    var isUnread: Bool { payoutValue == nil }
}
