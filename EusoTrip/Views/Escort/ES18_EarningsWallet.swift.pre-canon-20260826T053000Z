                Text("ASSIGNMENT RATES ONLY · NOT SETTLED PAYOUTS")
                    .font(EType.mono(.micro)).foregroundStyle(palette.textTertiary)
                Text("VERIFY THIS ESTIMATE AGAINST SETTLEMENTS BEFORE RELYING ON IT")
                    .font(EType.mono(.micro)).foregroundStyle(palette.textTertiary)
                    .fixedSize(horizontal: false, vertical: true)
            }
            // THE FOURTH STATE, RENDERED. When the figure in hand is exactly zero, the
            // wire cannot tell a real all-zero period from a COALESCE over NULL rates
            // from a swallowed DB exception — the payloads are identical bytes. The
            // screen refuses to pick one and says which three things it could be. This
            // is the render four gates never reached, because case (d) arrives as a
            // successful call and every `try?`-based failure branch is dead to it.
            if periodGrossIsAmbiguousZero {
                Text(Self.ambiguousZeroLine)
                    .font(EType.mono(.micro)).foregroundStyle(Brand.warning)
                    .fixedSize(horizontal: false, vertical: true)
