    let notes: String
}
private struct ES18DisputeResult: Codable { let success: Bool? }

/// The disk snapshot (READ_CACHED 10m). The wallet balance is deliberately ABSENT
/// from this type — money that cannot be verified is not painted from disk.
private struct ES18Snapshot: Codable {
    var stats: ES18Stats
    var history: ES18History?
    var settlements: [ES18Settlement]
    var completed: [ES18CompletedJob]
}

/// DA badge vocabulary. `inColumn` records whether the value can actually arrive on
/// escortAssignments.position today (schema.ts:3810 = lead | chase | both).
private enum ES18Position: String, CaseIterable, Identifiable {
    case lead, chase, both, highPole, steer
    var id: String { rawValue }
    var label: String {
        switch self {
        case .lead:     return "LEAD"
        case .chase:    return "CHASE"
        case .both:     return "LEAD + CHASE"
        case .highPole: return "HIGH-POLE"
        case .steer:    return "STEER"
        }
    }
    var tint: Color {
        switch self {
        // Matched to the twins: LEAD #1473FF, LEAD + CHASE #2196F3, CHASE #9C27B0.
        case .lead:     return Brand.blue          // #1473FF
        case .chase:    return Brand.escort        // #9C27B0
        case .both:     return Brand.info          // #2196F3
        case .steer:    return Brand.warning       // amber
        case .highPole: return Brand.hazmat        // orange
        }
    }
    var inColumn: Bool {
        switch self {
        case .lead, .chase, .both: return true
        case .highPole, .steer:    return false
        }
    }
    static func from(_ raw: String?) -> ES18Position? {
        guard let raw = raw?.lowercased() else { return nil }
        return ES18Position(rawValue: raw)
    }
}

/// A computed projection, not a wire type — the server ships no breakdown.
///
/// `amount` and `share` are OPTIONAL on purpose. A bucket assembled entirely from rows
/// whose `netPayout` was NULL has no amount, and a sum over nothing is not zero — it is
/// nothing. Making the field `Double` forced a coalesce somewhere, and the somewhere it
/// landed was a money cell. Absence now survives the aggregation, which is the only way
/// the render site can tell the three states apart.
private struct ES18Slice: Identifiable, Hashable {
    let position: ES18Position
    let moves: Int
    let miles: Int
    /// `nil` ⟺ every row in this bucket was unread. Otherwise the sum of the rows that
    /// WERE read — which is a partial sum whenever `unread > 0`, and says so on glass.
    let amount: Double?
    /// How many of `moves` carried no readable payout. In production this equals the
    /// number of rows in the bucket that are not yet `paid` — see the PAID ⟺ AMOUNT
    /// invariant in the header. `unread == 0` is the only state in which this row's
    /// money is complete.
    let unread: Int
    /// `nil` whenever the bucket is incomplete. A percentage of a partial sum, drawn
    /// against a total that is itself partial, is a second and more confident lie than
    /// the first — so the bar is suppressed rather than approximated.
    let share: Double?
    var id: String { position.rawValue }

    var isFullyRead: Bool { unread == 0 }
    var isWhollyUnread: Bool { unread == moves }
}

private enum ES18Period: String, CaseIterable, Identifiable {
    case week, month, quarter, year
    var id: String { rawValue }
    var label: String { rawValue.uppercased() }
}

