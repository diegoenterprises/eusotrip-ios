    /// THE FOURTH GATE'S CELL. Three states, three renders, no overlap:
    ///   (a) genuinely zero  — every row read, they summed to nothing → `$0.00`, primary
    ///                          ink, no warning line. A real zero is allowed to look
    ///                          like a real zero.
    ///   (b) NULL / unwritten — nothing in the bucket had an amount → `—`, tertiary ink,
    ///                          `N OF N NO AMOUNT READ` in warning, bar suppressed.
    ///                          A partial bucket takes the same warning with its own
    ///                          count and keeps its (partial) figure, also without a bar.
    ///   (c) unknown-by-error — this row is never reached: `settlementsFailed` replaces
    ///                          the whole breakdown upstream with an explicit refusal.
    /// The idiom is the PENDING cell's, deliberately — the file already had one correct
    /// disclosure for this exact fact and a second vocabulary would only teach the
    /// reader that the two mean different things.
    private func positionRow(_ s: ES18Slice) -> some View {
        VStack(alignment: .leading, spacing: 6) {
            HStack(spacing: 10) {
                Text(s.position.label)
                    .font(.system(size: 8, weight: .heavy)).tracking(0.5)
                    .foregroundStyle(.white)
                    .frame(width: 78, height: 18)
                    .background(Capsule().fill(s.position.tint))
                Text(s.miles > 0
                     ? "\(s.moves) MOVE\(s.moves == 1 ? "" : "S") · \(s.miles) MI"
                     : "\(s.moves) MOVE\(s.moves == 1 ? "" : "S")")
                    .font(EType.mono(.micro)).foregroundStyle(palette.textSecondary)
                Spacer(minLength: 6)
                if let amount = s.amount {
                    Text(currency(amount))
                        .font(.system(size: 13, weight: .bold, design: .monospaced))
                        .foregroundStyle(s.isFullyRead ? palette.textPrimary : Brand.warning)
                } else {
                    // Every line in this bucket was NULL. There is no number to show and
                    // `$0.00` would be one invented right here.
                    Text("—")
                        .font(.system(size: 13, weight: .bold, design: .monospaced))
                        .foregroundStyle(palette.textTertiary)
                }
            }
            if s.unread > 0 {
                Text(s.isWhollyUnread
                     ? "NO AMOUNT READ ON ANY OF \(s.moves) — NOT A ZERO"
                     : "PARTIAL · \(s.unread) OF \(s.moves) NO AMOUNT READ")
                    .font(EType.mono(.micro)).foregroundStyle(Brand.warning)
                    .lineLimit(1).minimumScaleFactor(0.7)
            } else if let share = s.share {
                HStack(spacing: 10) {
                    GeometryReader { geo in
                        ZStack(alignment: .leading) {
                            Capsule().fill(palette.bgCardSoft).frame(height: 4)
                            Capsule().fill(s.position.tint)
                                .frame(width: max(2, geo.size.width * share), height: 4)
                        }
                    }
                    .frame(height: 4)
                    Text(String(format: "%.1f%%", share * 100))
                        .font(EType.mono(.micro)).foregroundStyle(palette.textTertiary)
                        .frame(width: 46, alignment: .trailing)
                }
            } else {
                // Complete bucket, but no complete bucket anywhere carried money, so
                // there is no denominator. Say that instead of drawing an empty bar.
