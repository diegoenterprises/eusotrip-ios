    private var subheadline: String {
        let moves = periodMoves
        // Three renders for three facts, same as every money cell on this sheet: a read
        // that did not land says so, a real zero-mile period says nothing (there is
        // nothing to say), and a real figure prints.
        let milesPart: String
        switch periodMiles {
        case .none:
            milesPart = " · escorted mi — (DISTANCE READ FAILED)"
        case .some(0) where completed.isEmpty && moves > 0:
            // CASE (d) AT THE MILE CELL. getCompletedJobs swallows to `[]` at HTTP 200
            // (:2427, :2430, :2451), so a swallowed distance read arrives as an EMPTY
            // ARRAY, not as nil — `completedFailed` never fires and the miles silently
            // read zero. A period that has moves but no distance rows is the observable
            // shadow of that swallow, and it is the closest this cell can get to naming
            // case (d). It is also the honest render when the inner join on `loads`
            // dropped the rows for some other reason: either way we have no distance.
            milesPart = " · escorted mi — (NO DISTANCE ROWS FOR \(moves) MOVES)"
        case .some(0):
            milesPart = ""
        case .some(let m):
            milesPart = " · \(m.formatted()) escorted mi"
        }
        // An average needs a gross that was actually read. Without one the slot says
        // so rather than dividing an unread figure into a currency string.
        guard let gross = periodGross, moves > 0 else {
            return "\(moves) move\(moves == 1 ? "" : "s")\(milesPart) · avg — / move"
        }
        // Cell (2) is cell (1) over a count, so it inherits cell (1)'s three-valued zero.
        // It carries the marker rather than repeating the whole sentence, because the
        // sentence is already on glass one line above it and two copies of it would push
        // the actual figures off the fold.
        let avg = gross / Double(moves)
        let mark = isAmbiguousZero(gross) ? " (SEE ZERO NOTE)" : ""
        return "\(moves) move\(moves == 1 ? "" : "s")\(milesPart) · avg \(currency(avg)) / move\(mark)"
    }

