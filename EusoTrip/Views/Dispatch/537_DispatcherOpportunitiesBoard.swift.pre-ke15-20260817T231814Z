//  EusoTrip — Dispatcher · Opportunities Board.
//
//  Verbatim SwiftUI port of:
//    `04 Dispatcher/Dark-SVG/537 Dispatcher Opportunities Board.svg`
//
//  THE OPPORTUNITIES BOARD — every open (posted) load the dispatcher's fleet
//  can bid on, ranked so a matched lane can be applied to in one tap. Reached
//  from the Board (401) as the opportunities surface.
//
//  Honest wiring — 0 stubs, 0 mock data, fully dynamic:
//    • READ  dispatchRole.getOpportunities     (dispatchRole.ts:1052, query,
//            {status?,category?}) → [{ id, loadNumber, origin, destination,
//            rate, equipment, pickupDate, status }] — real posted-load rows.
//    • READ  dispatchRole.getOpportunityStats  (dispatchRole.ts:1074, query)
//            → { open, applied, accepted, total, totalValue, … } — real
//            count + summed rate of posted loads.
//    • WRITE dispatchRole.applyToOpportunity   (dispatchRole.ts:1082,
//            mutation, {opportunityId}) → { success, applicationId }. Fired by
//            "Apply to top match" and by tapping a row.
//    • The reads flow through a real do/catch with a surfaced error; the
//      screen shows the error state, never a fake success. Empty board →
//      honest empty state.
//
//  HONEST GAP: the platform has no application-tracking table yet, so
//  getOpportunityStats returns applied/accepted = 0 and applyToOpportunity is
//  an ack-only write (no persistence). Both are surfaced as-is — the counts
//  read 0 rather than a fabricated win rate, and the apply result is shown
//  honestly (handed to the-oath to back with a real applications table).
//
//  Persona: Aurora Freight Lines · Renée Marquette (RM) · shipper-of-record
//  Eusorone Technologies (Diego Usoro).
//  Powered by ESANG AI™.
//

import SwiftUI

// MARK: ─────────────────────────────────────────────────────────
// MARK: Decoders — field-for-field match to dispatchRole.getOpportunities / …Stats
// MARK: ─────────────────────────────────────────────────────────

private struct Opportunity: Decodable, Hashable, Identifiable {
    let id: String
    let loadNumber: String?
    let origin: String?
    let destination: String?
    let rate: Double?
    let equipment: String?
    let pickupDate: String?
    let status: String?
}

private struct OpportunityStats: Decodable, Hashable {
    let open: Int
    let applied: Int
    let accepted: Int
    let total: Int
    let totalValue: Double
}

// MARK: ─────────────────────────────────────────────────────────
// MARK: Screen
// MARK: ─────────────────────────────────────────────────────────

