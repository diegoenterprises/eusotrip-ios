private struct DispatcherDockCoordinationBody: View {
    @Environment(\.palette) private var palette

    @State private var loads: [DockLoad] = []
    @State private var asOf: String?
    @State private var loading: Bool = true
    @State private var actionError: String?
    @State private var coordinating: Bool = false
    @State private var coordinateNote: String?

    // Only loads still working toward a dock (exclude terminal states) count
    // as a "door". Delivery stop wins when present, else pickup.
    private var doors: [DockDoor] {
        loads.compactMap { l in
            let stop = l.delivery ?? l.pickup
            guard let stop else { return nil }
            let stage = DockCoord.stage(loadStatus: l.status, stop: stop)
            let facility = DockCoord.facility(stop)
            let subject = l.driverName ?? l.vehicleLabel ?? (l.loadNumber ?? "Load \(l.id)")
            let right = DockCoord.rightLabel(stage: stage, stop: stop)
            return DockDoor(id: l.id, facility: facility, subject: subject,
                            loadNumber: l.loadNumber, stage: stage, rightLabel: right)
        }
    }

    private var workingCount: Int { doors.filter { $0.stage == .working }.count }
    private var inboundCount:  Int { doors.filter { $0.stage == .inbound }.count }
    private var queuedCount:   Int { doors.filter { $0.stage == .queued  }.count }

    // Nearest still-open appointment window across all docks (real).
    private var nearestWindow: (label: String, facility: String)? {
        let now = Date()
        let candidates: [(Date, String)] = loads.compactMap { l in
            guard let stop = l.delivery ?? l.pickup,
                  let endIso = stop.appointmentEnd,
                  let end = DockCoord.date(endIso), end > now else { return nil }
            return (end, DockCoord.facility(stop))
        }.sorted { $0.0 < $1.0 }
        guard let first = candidates.first else { return nil }
        return (DockCoord.countdown(to: first.0), first.1)
    }

    private var topRows: [DockDoor] { Array(doors.prefix(3)) }
    private var moreCount: Int { max(0, doors.count - topRows.count) }

    var body: some View {
        ScrollView(showsIndicators: false) {
            VStack(alignment: .leading, spacing: 0) {
                topBar
                IridescentHairline().padding(.top, Space.s3)

                if loading {
                    DockCoordSkeleton().padding(.top, Space.s5)
                } else if let err = actionError {
                    errorState(err)
                } else {
                    heroCard
                    kpiStrip
                    doorList
                    windowGuard
                    if let note = coordinateNote { resultNote(note) }
                    ctaPair
                }

                Color.clear.frame(height: 96)
            }
            .padding(.horizontal, 20)
            .padding(.top, Space.s5)
        }
        .task { await load() }
    }

    // MARK: Top bar — back chevron + eyebrow + mono caption + title + kebab

    private var topBar: some View {
        VStack(alignment: .leading, spacing: Space.s2) {
            HStack(alignment: .firstTextBaseline) {
                EusoTripEyebrow(verbatim: "DISPATCHER · DOCK COORDINATION")
                    .font(EType.micro).tracking(1.0)
                    .foregroundStyle(LinearGradient.primary)
                Spacer(minLength: Space.s2)
                Text(nearestWindow.map { _ in "\(doors.count) DOORS" } ?? "\(doors.count) DOORS")
                    .font(EType.mono(.micro)).tracking(1.0)
                    .foregroundStyle(palette.textTertiary)
            }
            HStack(alignment: .center, spacing: Space.s3) {
                Button { back() } label: {
                    Image(systemName: "chevron.left")
                        .font(.system(size: 18, weight: .semibold))
                        .foregroundStyle(palette.textPrimary)
                }
                .buttonStyle(.plain)
                Text("Dock coordination")
                    .font(EType.h1).tracking(-0.4)
                    .foregroundStyle(palette.textPrimary)
                Spacer(minLength: Space.s2)
                Image(systemName: "ellipsis")
                    .font(.system(size: 17, weight: .bold))
                    .foregroundStyle(palette.textPrimary)
            }
        }
    }

    // MARK: Hero — the reserved-window ActiveCard

    private var heroCard: some View {
        VStack(alignment: .leading, spacing: Space.s3) {
            HStack(spacing: Space.s2) {
                chip("live")
                if let w = nearestWindow { chip(w.facility.lowercased()) }
                Spacer(minLength: 0)
            }
            HStack(alignment: .top) {
                VStack(alignment: .leading, spacing: 2) {
                    Text(nearestWindow?.label ?? "\(doors.count)")
                        .font(.system(size: 30, weight: .bold, design: .default).monospacedDigit())
                        .foregroundStyle(LinearGradient.diagonal)
                    Text(nearestWindow != nil ? "window open" : "docks active")
                        .font(EType.caption.weight(.semibold))
                        .foregroundStyle(palette.textPrimary)
                    Text(nearestWindow?.facility ?? "no reserved window")
                        .font(EType.caption)
                        .foregroundStyle(palette.textSecondary)
                }
                Spacer(minLength: Space.s3)
                VStack(alignment: .leading, spacing: 2) {
                    Text("DOORS")
                        .font(EType.micro).tracking(0.6)
                        .foregroundStyle(palette.textSecondary)
                    Text("\(doors.count)")
                        .font(.system(size: 22, weight: .bold).monospacedDigit())
                        .foregroundStyle(palette.textPrimary)
                    Text("\(workingCount) working")
                        .font(EType.caption)
                        .foregroundStyle(palette.textSecondary)
                }
            }
        }
        .padding(Space.s4)
        .frame(maxWidth: .infinity, alignment: .leading)
        .background(RoundedRectangle(cornerRadius: 20).fill(palette.bgCardSoft))
        .overlay(RoundedRectangle(cornerRadius: 20)
            .strokeBorder(LinearGradient.diagonal.opacity(0.85), lineWidth: 1.5))
        .padding(.top, Space.s5)
    }

    private func chip(_ label: String) -> some View {
        Text(label)
            .font(EType.micro).tracking(0.5)
            .foregroundStyle(palette.textPrimary)
            .padding(.horizontal, Space.s3).frame(height: 24)
            .background(Capsule().fill(Color.white.opacity(0.06)))
    }

    // MARK: KPI strip — WORKING (highlight) / INBOUND / QUEUED

    private var kpiStrip: some View {
        HStack(spacing: Space.s3) {
            kpiCell("AT DOOR",  workingCount, tint: palette.textOnGradient, filled: true)
            kpiCell("INBOUND",  inboundCount, tint: palette.textPrimary,     filled: false)
            kpiCell("QUEUED",   queuedCount,  tint: Brand.hazmat,            filled: false)
        }
        .padding(.top, Space.s4)
    }

    private func kpiCell(_ label: String, _ value: Int, tint: Color, filled: Bool) -> some View {
        VStack(alignment: .leading, spacing: Space.s3) {
            Text(label)
                .font(EType.micro).tracking(1.0)
                .foregroundStyle(filled ? palette.textOnGradient.opacity(0.85) : palette.textSecondary)
            Text("\(value)")
                .font(.system(size: 22, weight: .semibold).monospacedDigit())
                .foregroundStyle(tint)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .padding(Space.s3)
        .frame(height: 72)
        .background {
            if filled {
                RoundedRectangle(cornerRadius: 16).fill(LinearGradient.diagonal)
            } else {
                RoundedRectangle(cornerRadius: 16).fill(palette.bgCardSoft)
                RoundedRectangle(cornerRadius: 16).strokeBorder(palette.borderFaint, lineWidth: 1)
            }
        }
    }

    // MARK: Door list

    private var doorList: some View {
        VStack(alignment: .leading, spacing: 0) {
            HStack {
                Text("DOCK DOORS")
                    .font(EType.micro).tracking(1.0)
                    .foregroundStyle(palette.textSecondary)
                Spacer()
                Text("dispatcher.board")
                    .font(EType.mono(.caption))
                    .foregroundStyle(palette.textSecondary)
            }
            .padding(.bottom, Space.s2)

            VStack(spacing: 0) {
                if topRows.isEmpty {
                    emptyDoors
                } else {
                    ForEach(Array(topRows.enumerated()), id: \.element.id) { idx, d in
                        DockDoorRow(door: d)
                        if idx < topRows.count - 1 {
                            Divider().overlay(palette.borderFaint).padding(.horizontal, Space.s4)
                        }
                    }
                    if moreCount > 0 {
                        Text("+ \(moreCount) more · sorted by appointment window")
                            .font(EType.micro)
                            .foregroundStyle(palette.textSecondary)
                            .frame(maxWidth: .infinity, alignment: .leading)
                            .padding(Space.s4)
                    }
                }
            }
            .background(RoundedRectangle(cornerRadius: 16).fill(palette.bgCardSoft))
            .overlay(RoundedRectangle(cornerRadius: 16).strokeBorder(palette.borderFaint, lineWidth: 1))
        }
        .padding(.top, Space.s5)
