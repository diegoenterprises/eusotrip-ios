// MARK: ─────────────────────────────────────────────────────────
// MARK: Derivation helpers (real stop → dock semantics)
// MARK: ─────────────────────────────────────────────────────────

private enum DockCoord {
    static func stage(loadStatus: String?, stop: DockStop) -> DockDoor.Stage {
        let s = (stop.status ?? loadStatus ?? "").lowercased()
        if stop.arrivedAt != nil || s.contains("loading") || s.contains("unloading") || s.contains("at_") {
            return .working
        }
        if s.contains("en_route") || s.contains("assigned") || s.contains("dispatched") || s.contains("in_transit") {
            return .inbound
        }
        return .queued
    }

    static func facility(_ stop: DockStop) -> String {
        if let f = stop.facilityName, !f.isEmpty { return f }
        if let c = stop.city, let st = stop.state { return "\(c), \(st)" }
        return stop.city ?? "Dock"
    }

    static func rightLabel(stage: DockDoor.Stage, stop: DockStop) -> String {
        switch stage {
        case .working:
            return "at dock"
        case .inbound:
            if let end = stop.appointmentEnd, let d = date(end), d > Date() {
                return "ETA \(shortTime(d))"
            }
            return "inbound"
        case .queued:
            if let start = stop.appointmentStart, let d = date(start) {
                return d > Date() ? countdown(to: d) : "holding"
            }
            return "queued"
        }
    }

    static func date(_ iso: String) -> Date? {
        let f = ISO8601DateFormatter()
        f.formatOptions = [.withInternetDateTime, .withFractionalSeconds]
        if let d = f.date(from: iso) { return d }
        f.formatOptions = [.withInternetDateTime]
        return f.date(from: iso)
    }

    static func countdown(to target: Date) -> String {
        let secs = max(0, Int(target.timeIntervalSinceNow))
        let h = secs / 3600, m = (secs % 3600) / 60
        return h > 0 ? "\(h)h \(m)m" : "\(m)m"
    }

    static func shortTime(_ d: Date) -> String {
        let f = DateFormatter(); f.dateFormat = "HH:mm"
        return f.string(from: d)
    }
}

