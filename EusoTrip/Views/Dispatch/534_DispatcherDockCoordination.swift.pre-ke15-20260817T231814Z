//  534_DispatcherDockCoordination.swift
//  EusoTrip — Dispatcher · Dock Coordination.
//
//  Verbatim SwiftUI port of:
//    `04 Dispatcher/Dark-SVG/534 Dispatcher Dock Coordination.svg`
//
//  THE DOCK COORDINATION SURFACE — the dispatcher watches every active load
//  converging on a consignee/shipper dock: which trailers are inbound, which
//  are working a door, which are still queued on an appointment, and how much
//  of the pickup/delivery window is left. Reached from the Board (401) as the
//  dock-coordination surface.
//
//  Honest wiring — 0 stubs, 0 mock data, fully dynamic:
//    • READ   dispatcher.board            (dispatcher.ts:32, query, {date?})
//             → { drivers[], loads[], asOf }. Each active load carries its
//             pickup + delivery stop (facilityName, city/state, appointment
//             window, arrivedAt, status). The dock rows, the window
//             countdown, and the INBOUND / AT DOOR / QUEUED tallies are all
//             derived from these REAL stop rows — no fabricated door array.
//    • WRITE  dispatcher.openDockCoordination (dispatcher.ts:252, mutation,
//             {loadId, openedAtIso?}) → { success, loadId, openedAt }. Fired
//             by "Coordinate dock"; inserts a blockchainAuditTrail
//             `dispatcher.dock_coordination_opened` row for the top dock.
//    • The read flows through a real do/catch with a surfaced error; the
//      screen shows the error state, never a fake success. Empty fleet →
//      honest empty state.
//
//  HONEST GAP: the server exposes no physical door-number field, so rows are
//  keyed by the real facility + load rather than an invented "Door 7B" label.
//
//  Persona: Aurora Freight Lines · Renée Marquette (RM) dispatcher.
//  Powered by ESANG AI™.
//

import SwiftUI

// MARK: ─────────────────────────────────────────────────────────
// MARK: Decoders — field-for-field match to dispatcher.board
// MARK: ─────────────────────────────────────────────────────────

private struct DockStop: Decodable, Hashable {
    let facilityName: String?
    let city: String?
    let state: String?
    let appointmentStart: String?
    let appointmentEnd: String?
    let arrivedAt: String?
    let status: String?
}

private struct DockLoad: Decodable, Hashable, Identifiable {
    let id: Int
    let loadNumber: String?
    let status: String?
    let driverId: Int?
    let driverName: String?
    let vehicleLabel: String?
    let pickup: DockStop?
    let delivery: DockStop?
}

private struct DockBoardResponse: Decodable {
    let loads: [DockLoad]
    let asOf: String?
}

// MARK: ─────────────────────────────────────────────────────────
// MARK: Derived dock-door row (from real stops)
// MARK: ─────────────────────────────────────────────────────────

private struct DockDoor: Identifiable, Hashable {
    enum Stage { case working, inbound, queued }
    let id: Int
    let facility: String        // "PHX-WVDC" / city,state — real
    let subject: String         // driver / unit / load — real
    let loadNumber: String?
    let stage: Stage
    let rightLabel: String      // ETA / % / hold — real, from stop timing
}

