    private func resultNote(_ note: String) -> some View {
        Text(note)
            .font(EType.caption)
            .foregroundStyle(palette.textSecondary)
            .frame(maxWidth: .infinity, alignment: .leading)
            .padding(.top, Space.s3)
    }

    // MARK: CTA pair

    private var ctaPair: some View {
        HStack(spacing: Space.s3) {
            Button { Task { await coordinate() } } label: {
                HStack(spacing: Space.s2) {
                    if coordinating { ProgressView().tint(palette.textOnGradient) }
                    Text(coordinating ? "Opening…" : "Coordinate dock")
                        .font(EType.bodyStrong)
                        .foregroundStyle(palette.textOnGradient)
                }
                .frame(maxWidth: .infinity).frame(height: 48)
                .background(RoundedRectangle(cornerRadius: Radius.md, style: .continuous).fill(LinearGradient.primary))
            }
            .buttonStyle(.plain)
            .disabled(coordinating || doors.isEmpty)
            .opacity(doors.isEmpty ? 0.5 : 1)

            Button { Task { await load() } } label: {
                Text("Refresh")
                    .font(EType.bodyStrong)
                    .foregroundStyle(palette.textPrimary)
                    .frame(width: 132).frame(height: 48)
                    .background(RoundedRectangle(cornerRadius: Radius.md, style: .continuous).fill(Color(hex: 0x232932)))
            }
            .buttonStyle(.plain)
            .disabled(coordinating)
        }
        .padding(.top, Space.s5)
    }

    // MARK: Error state

    private func errorState(_ err: String) -> some View {
        VStack(alignment: .leading, spacing: Space.s2) {
            Text("Couldn't load the dock board").font(EType.bodyStrong).foregroundStyle(palette.textPrimary)
            Text(err).font(EType.caption).foregroundStyle(Brand.danger)
            Button { Task { await load() } } label: {
                Text("Retry").font(EType.caption.weight(.heavy))
                    .foregroundStyle(palette.textOnGradient)
                    .padding(.horizontal, Space.s4).frame(height: 32)
                    .background(Capsule().fill(LinearGradient.primary))
            }
            .buttonStyle(.plain).padding(.top, Space.s1)
        }
        .frame(maxWidth: .infinity, alignment: .leading)
        .padding(Space.s4)
        .background(RoundedRectangle(cornerRadius: Radius.lg).fill(palette.bgCardSoft))
        .overlay(RoundedRectangle(cornerRadius: Radius.lg).strokeBorder(Brand.danger.opacity(0.4), lineWidth: 1))
        .padding(.top, Space.s5)
    }

    // MARK: Data + actions

    private func load() async {
        loading = true
        actionError = nil
        coordinateNote = nil
        struct In: Encodable {}
        do {
            let r: DockBoardResponse = try await EusoTripAPI.shared.query("dispatcher.board", input: In())
            loads = r.loads
            asOf = r.asOf
        } catch {
            actionError = "The dock board couldn't refresh. Retry from this screen or open the dispatch board."
        }
        loading = false
    }

    private func coordinate() async {
        guard let top = topRows.first, let ln = top.loadNumber ?? loads.first?.loadNumber else { return }
        coordinating = true
        coordinateNote = nil
        struct In: Encodable { let loadId: String }
        struct Out: Decodable { let success: Bool?; let openedAt: String? }
        do {
            let _: Out = try await EusoTripAPI.shared.mutation("dispatcher.openDockCoordination", input: In(loadId: ln))
            coordinateNote = "Dock coordination opened for \(ln) · logged to the audit trail."
        } catch {
            coordinateNote = "Couldn't open dock coordination for \(ln). Try again."
        }
        coordinating = false
    }

    private func back() {
        NotificationCenter.default.post(name: .eusoDispatchNavSwap, object: nil, userInfo: ["screenId": "Disp401"])
    }
}

