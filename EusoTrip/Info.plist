<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export-compliance declaration. The app uses only exempt
	     encryption (HTTPS/TLS via the system frameworks — no custom or
	     non-standard crypto). Declaring NO here auto-answers App Store
	     Connect's export-compliance question at upload time, so every
	     build goes straight to "Ready to Test" in TestFlight instead of
	     stalling on "Missing Compliance" — which is what was keeping
	     approved builds from ever appearing for testers. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Custom URL scheme for password reset deep links + vendor OAuth callbacks
	     (eusotrip://reset?token=… , eusotrip://oauth/callback/<vendor>?code=…&state=…). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.app.eusotrip</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>eusotrip</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<!-- HOS clock + geofence + ESANG voice + load lifecycle progress
		     all need to keep ticking when the wrist is the only screen
		     awake. Without `location` the geofence enter/exit events
		     never fire while the phone is locked; without `audio` the
		     ESANG voice session drops the moment the screen sleeps;
		     without `fetch` + `processing` the BGTaskScheduler stops
		     waking the app for the 5-min HOS poll. -->
		<string>location</string>
		<string>audio</string>
		<string>fetch</string>
		<string>processing</string>
		<!-- Push-to-Talk (EusoTrip Pulse). Required by the PushToTalk
		     framework so the system can wake the app in the background on a
		     `pushtotalk` APNs push to open the convoy channel speaker. Pairs
		     with the com.apple.developer.push-to-talk entitlement. -->
		<string>push-to-talk</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<!-- Identifiers BGTaskScheduler will allow when registered.
		     `com.eusotrip.hos.poll` powers the 5-min HOS dashboard
		     refresh; `com.eusotrip.outbox.drain` flushes the offline
		     mutation queue when reachability flaps positive. -->
		<string>com.eusotrip.hos.poll</string>
		<string>com.eusotrip.outbox.drain</string>
	</array>
	<!-- Always + WhenInUse so the geofence handler keeps firing when
	     the driver pockets the phone mid-route. The when-in-use string
	     stays as the always-permission toggle's parent description per
	     Apple's 2-step prompt flow. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>EusoTrip uses your background location so geofence arrival, automatic HOS state changes, and ESANG smart-stop suggestions keep working when your phone is locked or in your pocket.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Usage descriptions -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>EusoTrip uses your location to show route weather, traffic, and nearby loads, and to automatically advance your trip screens when you arrive at pickup or delivery.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>EusoTrip uses the microphone for ESANG voice commands so you can talk to your copilot hands-free.</string>
	<key>NSMotionUsageDescription</key>
	<string>EusoTrip uses motion data to auto-detect when you start and stop driving so your HOS clock and trip screens advance without a tap.</string>
	<key>NSNearbyInteractionUsageDescription</key>
	<string>EusoTrip uses Ultra-Wideband to help you dock your truck precisely at loading bays and to coordinate hazmat escort handoffs with nearby drivers.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>EusoTrip transcribes what you say to ESANG on-device so your copilot can answer and navigate the app for you.</string>
	<key>NSCameraUsageDescription</key>
	<string>EusoTrip uses your camera to scan dock-door markers for AR-guided back-in alignment, capture proof-of-delivery photos, and read BOL barcodes.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>EusoTrip lets you attach photos from your library to load documents (BOL, rate con, damage reports).</string>
	<key>NSHealthShareUsageDescription</key>
	<string>EusoTrip reads your recent sleep, resting heart rate, and heart-rate variability from Apple Health to assess fatigue and fitness-for-duty (§392.3). Your health data stays private — it is never shared with your shipper or carrier.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>EusoTrip only reads your sleep and recovery data to assess fatigue (§392.3) — it does not write to Apple Health. This permission is required by the HealthKit framework. Your health data is never shared with your shipper or carrier.</string>
	<!-- ActivityKit Live Activities — required for ShipperLoadActivityAttributes.
	     When YES, `Activity<…>.request(...)` succeeds; when NO/missing, every
	     request throws and the lock-screen card never appears. -->
	<key>NSSupportsLiveActivities</key>
	<true/>
	<!-- Live Activities can stay on the lock screen even when the app is
	     fully suspended; the system pushes new ContentState via APNs.
	     Required for the per-load activity to update during long routes. -->
	<key>NSSupportsLiveActivitiesFrequentUpdates</key>
	<true/>
	<!-- Continuity / Handoff activity types — every NSUserActivity the app
	     calls `becomeCurrent()` on must be declared here, otherwise iOS
	     silently drops the advertise. Mirrors the
	     `ShipperHandoffActivityType` enum in
	     `EusoTrip/Services/ShipperHandoffContinuity.swift`. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.app.eusotrip.LoadDetailActivity</string>
		<string>com.app.eusotrip.PostLoadActivity</string>
		<string>com.app.eusotrip.SettlementActivity</string>
		<string>com.app.eusotrip.BidsActivity</string>
		<string>com.app.eusotrip.ControlTowerActivity</string>
		<!-- Watch → phone Handoff: EusoTrip Pulse publishes this activity
		     so the EusoTrip icon appears on the iPhone lock screen / App
		     Switcher for a one-tap open. Without this declaration iOS
		     silently refuses to continue the activity even though
		     EusoTripApp+WatchBridge registers a handler for it. -->
		<string>com.eusotrip.esang.activate</string>
	</array>
	<!-- Online HERE REST credentials resolve from the gitignored local
	     configuration. No credential value is tracked in this plist. -->
	<key>HEREAccessKeyId</key>
	<string>$(HERE_ACCESS_KEY_ID)</string>
	<key>HEREAccessKeySecret</key>
	<string>$(HERE_ACCESS_KEY_SECRET)</string>
	<key>HEREClientId</key>
	<string>$(HERE_CLIENT_ID)</string>
	<key>HEREUserId</key>
	<string>$(HERE_USER_ID)</string>
	<key>HERETokenEndpointURL</key>
	<string>https://account.api.here.com/oauth2/token</string>
	<!-- Referrer-restricted Maps JS key. This powers the online WKWebView map
	     only and cannot initialize HERE SDK Navigate. -->
	<key>HEREJSApiKey</key>
	<string>$(HERE_JS_API_KEY)</string>
	<!-- Dedicated HERE SDK Navigate mobile credentials. Values come from the
	     gitignored EusoTrip.xcconfig and must never be committed or logged.
	     The runtime rejects empty and unsubstituted values. -->
	<key>HERESDKAccessKeyID</key>
	<string>$(HERE_SDK_ACCESS_KEY_ID)</string>
	<key>HERESDKAccessKeySecret</key>
	<string>$(HERE_SDK_ACCESS_KEY_SECRET)</string>
</dict>
</plist>
