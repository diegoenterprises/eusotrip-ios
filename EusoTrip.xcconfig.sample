//
//  EusoTrip.xcconfig.sample
//  Copy this to EusoTrip.xcconfig (which is .gitignored) and fill in real values.
//
//  Xcode: Project settings → Configurations → set "Based on Configuration File"
//         to this file for both Debug and Release.
//

// ---- Online HERE Maps JavaScript key -------------------------------------
// Referrer-restricted to the trusted EusoTrip web origin. This key cannot
// initialize HERE SDK Navigate and provides no persistent offline maps.
HERE_JS_API_KEY         = REPLACE_WITH_HERE_JS_API_KEY

// ---- HERE SDK Navigate mobile credentials -------------------------------
// Provision these only after the registered application has Navigate access.
// They are intentionally separate from backend OAuth and Maps JS credentials.
// EusoTrip.xcconfig is gitignored; never commit or print real values.
HERE_SDK_ACCESS_KEY_ID      = REPLACE_WITH_NAVIGATE_ACCESS_KEY_ID
HERE_SDK_ACCESS_KEY_SECRET  = REPLACE_WITH_NAVIGATE_ACCESS_KEY_SECRET

// Custom map archives remain fail-closed until artifact hash, runtime,
// multi-zoom, theme, and accessibility review gates all pass.
